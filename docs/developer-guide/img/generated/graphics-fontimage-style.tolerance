# Glyph rasterization differs between macOS and Linux for the same bundled font
# at the same size, so this figure does not come back byte-identical when it is
# regenerated on a developer's machine. Measured against the CI runner's own
# output, which is what the committed image is: 0.4322% of pixels differ, worst
# channel delta 56.
#
# Both bounds are set from that measurement rather than left wide open.
# maxMismatchPercent limits how much of the image may change AT ALL -- every
# differing pixel counts, not only those past the delta -- so a wholesale recolour
# cannot creep through in small steps. maxChannelDelta then caps how far any one
# pixel may move; 80 clears the measured worst with room while a solid overwrite
# still fails it. A blanket 255 would have disabled this bound entirely.
maxChannelDelta=80
maxMismatchPercent=0.61
