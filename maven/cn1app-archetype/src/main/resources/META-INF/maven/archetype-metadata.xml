<?xml version="1.0" encoding="UTF-8"?>
<archetype-descriptor xsi:schemaLocation="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0 http://maven.apache.org/xsd/archetype-descriptor-1.1.0.xsd" name="filechooser-demo"
    xmlns="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <requiredProperties>
    <requiredProperty key="cn1Version">
      <defaultValue>8.0-SNAPSHOT</defaultValue>
    </requiredProperty>
    <requiredProperty key="cn1PluginVersion">
      <defaultValue>8.0-SNAPSHOT</defaultValue>
    </requiredProperty>
    <requiredProperty key="kotlinVersion">
      <defaultValue>1.3.72</defaultValue>
    </requiredProperty>
    <requiredProperty key="javaVersion">
      <!-- Sets codename1.arg.java.version (build server) and the maven-compiler
           source/target. Java 17 is the default (matching start.codenameone.com);
           it is also required for Flutter support (src/main/flutter), whose
           transpiler emits Java 17 source. Pass 8 explicitly for legacy
           projects, or "auto" to pick 17 on a JDK >= 17 and 8 otherwise via
           archetype-post-generate.groovy. -->
      <defaultValue>17</defaultValue>
    </requiredProperty>

    <requiredProperty key="mainName">
      <validationRegex>^[A-Z][a-zA-Z0-9]+$</validationRegex>
    </requiredProperty>

  </requiredProperties>

  <fileSets>

    <fileSet encoding="UTF-8">
      <directory>.mvn</directory>
      <includes>
        <include>**/*.config</include>
      </includes>
    </fileSet>
    <fileSet encoding="UTF-8">
      <directory>.mvn/wrapper</directory>
      <includes>
        <include>**</include>
      </includes>
    </fileSet>
    <fileSet encoding="UTF-8" filtered="true">
      <directory>.idea</directory>
      <includes>
        <include>**</include>
      </includes>
    </fileSet>
    <fileSet encoding="UTF-8" filtered="true">
      <directory>.vscode</directory>
      <includes>
        <include>**</include>
      </includes>
    </fileSet>
    <!--
      The Codename One authoring skill, in the same three-part layout the
      initializr generates: .agent-skills/codename-one/** is the skill itself,
      .claude/skills/codename-one/SKILL.md is a thin stub that redirects to it,
      and AGENTS.md (in the root fileSet below) is the vendor-neutral pointer.
      All three are staged into the archetype JAR at build time from
      scripts/initializr/common/src/main/resources/** (see
      maven/cn1app-archetype/pom.xml). They always extract; the post-generate
      groovy deletes all three when the resolved javaVersion is 8 so only Java 17
      projects ship the skill.
      filtered="false" — skill markdown has $foo placeholders that Velocity
      would otherwise misinterpret.
    -->
    <fileSet encoding="UTF-8">
      <directory>.agent-skills</directory>
      <includes>
        <include>**</include>
      </includes>
    </fileSet>
    <fileSet encoding="UTF-8">
      <directory>.claude</directory>
      <includes>
        <include>**</include>
      </includes>
    </fileSet>
    <fileSet encoding="UTF-8">
      <directory>tools/netbeans</directory>
      <includes>
        <include>nb-configuration.xml</include>
        <include>nbactions.xml</include>
        <include>nbactions-*.xml</include>

      </includes>
    </fileSet>
    <fileSet encoding="UTF-8">
      <directory></directory>
      <includes>
        <include>.gitignore</include>
        <!-- Root pointer to .agent-skills/; see the skill fileSets above. -->
        <include>AGENTS.md</include>
        <include>*.sh</include>
        <include>*.bat</include>
        <include>*.adoc</include>
        <include>mvnw</include>
        <include>mvnw.cmd</include>

      </includes>
    </fileSet>
    <fileSet filtered="true" encoding="UTF-8">
      <directory>tools/eclipse</directory>
      <includes>
        <include>*.launch</include>
      </includes>

    </fileSet>
  </fileSets>
  <modules>
    <module id="${rootArtifactId}-common" dir="common" name="${rootArtifactId}-common">
      <fileSets>
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
          <directory>src/main/java</directory>
          <includes>
            <include>**/*.java</include>
          </includes>
        </fileSet>
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
          <directory>src/main/guibuilder</directory>
          <includes>
            <include>**/*.gui</include>
          </includes>
        </fileSet>
        <fileSet encoding="UTF-8">
          <directory>src/main/css</directory>
          <includes>
            <include>**/*.css</include>
          </includes>
        </fileSet>
        <fileSet encoding="UTF-8">
          <directory>src/main/l10n</directory>
          <includes>
            <include>**/*.properties</include>
          </includes>
        </fileSet>
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
          <directory>src/test/java</directory>
          <includes>
            <include>**/*.java</include>
          </includes>
        </fileSet>



        <fileSet filtered="true" encoding="UTF-8">
          <directory></directory>
          <includes>
            <include>codenameone_settings.properties</include>
          </includes>
        </fileSet>
        <fileSet encoding="UTF-8">
          <directory></directory>
          <includes>
            <include>icon.png</include>
          </includes>
        </fileSet>
      </fileSets>
    </module>
    <module id="${rootArtifactId}-javase" dir="javase" name="${rootArtifactId}-javase">
      <fileSets>
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
          <directory>src/main/java</directory>

          <includes>
            <include>**/*.java</include>
          </includes>
        </fileSet>
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
          <directory>src/desktop/java</directory>

          <includes>
            <include>**/*.java</include>
          </includes>
        </fileSet>
        <fileSet encoding="UTF-8">
          <directory>src/main/resources</directory>
          <includes>
            <include>**</include>
          </includes>
        </fileSet>
        <fileSet encoding="UTF-8">
          <directory>src/desktop/resources</directory>
          <includes>
            <include>**</include>
          </includes>
        </fileSet>
      </fileSets>
    </module>
    <module id="${rootArtifactId}-javascript" dir="javascript" name="${rootArtifactId}-javascript">
      <fileSets>
        <fileSet encoding="UTF-8">
          <directory>src/main/resources</directory>
          <includes>
            <include>**</include>
          </includes>
        </fileSet>
        <fileSet encoding="UTF-8">
          <directory>src/main/javascript</directory>
          <includes>
            <include>**</include>
          </includes>
        </fileSet>
      </fileSets>
    </module>
    <module id="${rootArtifactId}-ios" dir="ios" name="${rootArtifactId}-ios">
      <fileSets>
        <fileSet encoding="UTF-8">
          <directory>src/main/resources</directory>
          <includes>
            <include>**</include>
          </includes>
        </fileSet>
        <fileSet encoding="UTF-8">
          <directory>src/main/objectivec</directory>
          <includes>
            <include>**</include>
          </includes>
        </fileSet>
      </fileSets>
    </module>

    <module id="${rootArtifactId}-android" dir="android" name="${rootArtifactId}-android">
      <fileSets>
        <fileSet encoding="UTF-8">
          <directory>src/main/resources</directory>
          <includes>
            <include>**</include>
          </includes>
        </fileSet>
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
          <directory>src/main/java</directory>
          <includes>
            <include>**/*.java</include>
          </includes>
        </fileSet>
      </fileSets>
    </module>
    <module id="${rootArtifactId}-win" dir="win" name="${rootArtifactId}-win">
      <fileSets>
        <fileSet encoding="UTF-8">
          <directory>src/main/resources</directory>
          <includes>
            <include>**</include>
          </includes>
        </fileSet>
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
          <directory>src/main/c</directory>
          <includes>
            <include>**/*.c</include>
            <include>**/*.h</include>
          </includes>
        </fileSet>
      </fileSets>
    </module>
    <module id="${rootArtifactId}-linux" dir="linux" name="${rootArtifactId}-linux">
      <fileSets>
        <fileSet encoding="UTF-8">
          <directory>src/main/resources</directory>
          <includes>
            <include>**</include>
          </includes>
        </fileSet>
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
          <directory>src/main/c</directory>
          <includes>
            <include>**/*.c</include>
            <include>**/*.h</include>
          </includes>
        </fileSet>
      </fileSets>
    </module>
    <module id="${rootArtifactId}-backend" dir="backend" name="${rootArtifactId}-backend">
      <fileSets>
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
          <directory>src/main/java</directory>
          <includes>
            <include>**/*.java</include>
          </includes>
        </fileSet>
        <!--
             The configuration the server reads at start-up.

             In the MODULE ROOT rather than src/main/resources, which is where a
             Spring developer would look for it and where it would never be read:
             this runtime has no classpath to load a resource from, and Config
             opens application*.properties as FILES relative to the working
             directory. `cn1:backend` runs the server with the module directory
             as its working directory (BackendRunMojo sets it), and a packaged
             binary reads them from wherever it is started, so the module root is
             the one place both find.

             Not packaged, because these are resources rather than classes; and
             not filtered, because a properties file is full of ${...} references
             that the SERVER resolves from the environment and the archetype's
             own filter would consume first.
        -->
        <fileSet filtered="false" encoding="UTF-8">
          <directory></directory>
          <includes>
            <include>application*.properties</include>
          </includes>
        </fileSet>
      </fileSets>
    </module>
  </modules>
</archetype-descriptor>
