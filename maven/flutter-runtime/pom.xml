<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <parent>
        <groupId>com.codenameone</groupId>
        <artifactId>codenameone</artifactId>
        <version>8.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>codenameone-flutter-runtime</artifactId>
    <version>8.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>codenameone-flutter-runtime</name>
    <description>
        Java implementation of the Flutter widget framework on top of
        Codename One components: Widget/State/Element reconciliation, the
        Flutter box-constraint layout engine, the material widget catalog and
        the ThemeData-to-UIManager theme overlay. Transpiled Dart widget code
        (from the codenameone-dart-transpiler) runs against this API. Ships
        Dart signature stubs under META-INF/dart which the transpiler reads
        to resolve this API from Dart source.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
    </properties>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- The plugin packs (com.codename1.flutter.plugins.*) are not compiled into
                 this jar. They ship as SOURCES under META-INF/dart/java, and the transpiler
                 copies into its output only the packs the generated code (or the app's own
                 Java) names, so an app that never imports geolocator never contains a
                 class that names LocationManager, and no builder has to prune anything.
                 Builders already drop META-INF/dart/ from every bundle. -->
            <resource>
                <directory>src/main/plugins</directory>
                <targetPath>META-INF/dart/java</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <!-- Compile-check the packs with the tests (never packaged as classes). -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>plugin-pack-sources</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/main/plugins</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- source/target are set explicitly, not just release: the parent's
                         pluginManagement pins an explicit <source>1.8</source>, and an
                         inherited explicit value beats this module's maven.compiler.*
                         properties, so release alone leaves javac on -source 8. -->
                    <source>17</source>
                    <target>17</target>
                    <release>17</release>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>java17-fork</id>
            <activation>
                <property>
                    <name>env.JAVA17_HOME</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <!-- source/target are set explicitly, not just release: the parent's
                         pluginManagement pins an explicit <source>1.8</source>, and an
                         inherited explicit value beats this module's maven.compiler.*
                         properties, so release alone leaves javac on -source 8. -->
                    <source>17</source>
                    <target>17</target>
                    <release>17</release>
                            <fork>true</fork>
                            <executable>${env.JAVA17_HOME}/bin/javac</executable>
                        </configuration>
                    </plugin>
                    <plugin>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <jvm>${env.JAVA17_HOME}/bin/java</jvm>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-dart-runtime</artifactId>
            <!-- Never a literal: the two runtimes are released together, and
                 frozen-coordinates.py reads any literal com.codenameone version
                 as a pin the release must find already published. -->
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
