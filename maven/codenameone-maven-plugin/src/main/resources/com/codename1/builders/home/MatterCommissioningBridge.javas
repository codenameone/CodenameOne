package com.codename1.impl.android.home;

import android.app.Activity;
import android.content.ActivityNotFoundException;
import android.content.ComponentName;
import android.content.Intent;
import android.content.IntentSender;
import android.content.pm.PackageManager;
import android.net.Uri;
import android.provider.Settings;

import com.codename1.impl.android.AndroidNativeUtil;
import com.codename1.impl.android.AndroidSmartHomeSupport;
import com.codename1.impl.android.CodenameOneActivity;
import com.codename1.impl.android.IntentResultListener;
import com.codename1.impl.android.SmartHomeDelegate;

import com.google.android.gms.common.ConnectionResult;
import com.google.android.gms.common.GoogleApiAvailability;
import com.google.android.gms.home.matter.Matter;
import com.google.android.gms.home.matter.commissioning.CommissioningRequest;
import com.google.android.gms.home.matter.commissioning.CommissioningResult;
import com.google.android.gms.tasks.OnFailureListener;
import com.google.android.gms.tasks.OnSuccessListener;

/**
 * The Google Play services half of {@code com.codename1.home} on Android.
 *
 * <p>The build server copies this file into the application's own source tree
 * and weaves a {@code register()} call into the generated activity, but only
 * for apps whose bytecode references {@code com.codename1.home}. Everything it
 * touches -- Play services, the Matter commissioning API -- is on the app's
 * Gradle classpath and not on the port's, which is why it lives here rather
 * than in {@code Ports/Android}.</p>
 *
 * <h2>It reports COMMISSIONING_ONLY, and that is the honest answer</h2>
 *
 * <p>Play services can add a Matter accessory to the user's Google Home with
 * no setup at all: no account linking, no Cloud project, no console
 * registration. What it cannot do is let this app <em>see</em> or
 * <em>control</em> that accessory afterwards -- the graph belongs to Google
 * Home, and reading it needs the Google Home APIs, a Google Cloud project and
 * a Home Developer Console registration carrying the SHA-1 of the developer's
 * own signing key. None of that can be shipped on their behalf.</p>
 *
 * <p>So the graph here is empty and
 * {@code HomeAvailability.COMMISSIONING_ONLY} is what
 * {@code SmartHome.getAvailability()} reports. Reporting {@code AVAILABLE}
 * would make the constant mean something entirely different on Android than
 * on iOS, and an app written against the iOS meaning would render an empty
 * house with no explanation.</p>
 *
 * <h2>The flow is an Activity result</h2>
 *
 * <p>{@code CommissioningClient.commissionDevice} answers with an
 * {@code IntentSender} rather than doing anything, because the interaction
 * belongs to Play services' own UI. This class starts it, parks the callback,
 * and reads {@code CommissioningResult.fromIntentSenderResult} back out of
 * {@code onActivityResult}.</p>
 */
public final class MatterCommissioningBridge implements SmartHomeDelegate {

    /**
     * The request code the commissioning activity comes back on.
     *
     * <p>Deliberately high and specific. {@code IntentResultListener} reserves
     * the low numbers for the framework's own captures, and colliding with one
     * would route a camera result into this class.</p>
     */
    private static final int REQUEST_COMMISSION = 0x51A7;

    private static final String[] NOTHING = new String[0];

    /** com.codename1.home.HomeAvailability ordinals. */
    private static final int AVAIL_COMMISSIONING_ONLY = 1;
    private static final int AVAIL_PROVIDER_NOT_INSTALLED = 6;
    private static final int AVAIL_PROVIDER_UPDATE_REQUIRED = 7;

    /** com.codename1.home.HomeAuthorizationStatus ordinals. */
    private static final int AUTH_AUTHORIZED = 1;
    private static final int AUTH_UNKNOWN = 4;

    /** com.codename1.home.commissioning.CommissioningStyle ordinals. */
    private static final int STYLE_OS_OWNED_UI = 0;
    private static final int STYLE_APP_HANDOFF = 1;

    private static final String GOOGLE_HOME_PACKAGE =
            "com.google.android.apps.chromecast.app";

    private Callback pendingCommission;

    private MatterCommissioningBridge() {
    }

    /**
     * Publishes this bridge to the port. Called from the generated activity's
     * {@code onCreate}.
     */
    public static void register() {
        AndroidSmartHomeSupport.setDelegate(new MatterCommissioningBridge());
    }

    @Override
    public void setEventSink(EventSink sink) {
        // Nothing to push. There is no graph to change and no trait to watch,
        // so this backend never produces an unsolicited event; holding the
        // sink would only suggest otherwise.
    }

    @Override
    public int availability() {
        int status = GoogleApiAvailability.getInstance()
                .isGooglePlayServicesAvailable(AndroidNativeUtil.getContext());
        if (status == ConnectionResult.SERVICE_VERSION_UPDATE_REQUIRED) {
            return AVAIL_PROVIDER_UPDATE_REQUIRED;
        }
        if (status != ConnectionResult.SUCCESS) {
            return AVAIL_PROVIDER_NOT_INSTALLED;
        }
        return AVAIL_COMMISSIONING_ONLY;
    }

    @Override
    public int authorizationStatus() {
        // Commissioning needs no grant from this app's point of view: Play
        // services runs the whole interaction and asks the user itself. There
        // is nothing to have been authorized, so AUTHORIZED is reported when
        // the provider is usable and UNKNOWN otherwise -- rather than
        // NOT_DETERMINED, which would send an app into a permission flow that
        // has nothing to prompt for.
        return availability() == AVAIL_COMMISSIONING_ONLY ? AUTH_AUTHORIZED
                : AUTH_UNKNOWN;
    }

    @Override
    public String[] configurationProblems() {
        // Not a problem, and said here because this is the only channel that
        // reaches a developer looking at why the house is empty. The text is
        // for them, never for a user.
        return new String[] {
            "This build includes Matter commissioning but not the Google Home "
            + "APIs, so accessories can be added and not read or controlled. "
            + "The accessory graph needs a Google Cloud project and a Home "
            + "Developer Console registration carrying your signing key's "
            + "SHA-1, which Codename One cannot create on your behalf."
        };
    }

    @Override
    public void start(Callback callback) {
        callback.onSuccess(NOTHING);
    }

    @Override
    public void stop() {
        pendingCommission = null;
    }

    @Override
    public void requestAuthorization(Callback callback) {
        callback.onSuccess(NOTHING);
    }

    @Override
    public boolean openHomeSettings() {
        Activity activity = AndroidNativeUtil.getActivity();
        if (activity == null) {
            return false;
        }
        try {
            Intent intent = new Intent(
                    Settings.ACTION_APPLICATION_DETAILS_SETTINGS,
                    Uri.parse("package:" + activity.getPackageName()));
            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
            activity.startActivity(intent);
            return true;
        } catch (ActivityNotFoundException noSettings) {
            // Some heavily customized builds have no app-details screen.
            // Answering false lets the caller say so rather than promising a
            // trip that never happened.
            return false;
        }
    }

    @Override
    public boolean openEcosystemApp() {
        Activity activity = AndroidNativeUtil.getActivity();
        if (activity == null) {
            return false;
        }
        PackageManager packages = activity.getPackageManager();
        Intent launch = packages.getLaunchIntentForPackage(
                GOOGLE_HOME_PACKAGE);
        if (launch == null) {
            return false;
        }
        launch.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
        activity.startActivity(launch);
        return true;
    }

    @Override
    public boolean openProviderSetup() {
        Activity activity = AndroidNativeUtil.getActivity();
        if (activity == null) {
            return false;
        }
        GoogleApiAvailability availability =
                GoogleApiAvailability.getInstance();
        int status = availability.isGooglePlayServicesAvailable(activity);
        if (status == ConnectionResult.SUCCESS) {
            return false;
        }
        // Play services owns the wording and the destination -- install,
        // update or enable, depending on which of those is wrong. Sending the
        // user to a hard-coded Play listing would be right only sometimes.
        return availability.isUserResolvableError(status)
                && availability.showErrorDialogFragment(activity, status, 0);
    }

    // ------------------------------------------------------------------
    // No graph
    // ------------------------------------------------------------------

    @Override
    public String[] structures() {
        return NOTHING;
    }

    @Override
    public String[] rooms(String structureId) {
        return NOTHING;
    }

    @Override
    public String[] accessories(String structureId) {
        return NOTHING;
    }

    @Override
    public String[] services(String accessoryId) {
        return NOTHING;
    }

    @Override
    public String[] traits(String accessoryId, String serviceId) {
        return NOTHING;
    }

    @Override
    public void refresh(Callback callback) {
        callback.onSuccess(NOTHING);
    }

    @Override
    public void readTraits(String[] accessoryIds, String[] serviceIds,
            String[] traitIds, boolean allowCached, Callback callback) {
        callback.onError("NOT_SUPPORTED", graphUnavailable());
    }

    @Override
    public void writeTraits(String[] accessoryIds, String[] serviceIds,
            String[] traitIds, int[] kinds, double[] numericValues,
            String[] stringValues, int[] unitWireIds,
            String[] authorizationData, Callback callback) {
        callback.onError("NOT_SUPPORTED", graphUnavailable());
    }

    @Override
    public boolean isPushDelivery() {
        return false;
    }

    @Override
    public void subscribe(String subscriptionId, String[] accessoryIds,
            String[] serviceIds, String[] traitIds, Callback callback) {
        callback.onError("NOT_SUPPORTED", graphUnavailable());
    }

    @Override
    public void unsubscribe(String subscriptionId) {
    }

    @Override
    public void drainChanges(Callback callback) {
        callback.onSuccess(new String[] {"0"});
    }

    @Override
    public String[] scenes(String structureId) {
        return NOTHING;
    }

    @Override
    public String[] sceneActions(String structureId, String sceneId) {
        return NOTHING;
    }

    @Override
    public void executeScene(String structureId, String sceneId,
            Callback callback) {
        callback.onError("NOT_SUPPORTED", graphUnavailable());
    }

    @Override
    public void createScene(String structureId, String name,
            String[] accessoryIds, String[] serviceIds, String[] traitIds,
            int[] kinds, double[] numericValues, String[] stringValues,
            int[] unitWireIds, Callback callback) {
        callback.onError("NOT_SUPPORTED", graphUnavailable());
    }

    @Override
    public void deleteScene(String structureId, String sceneId,
            Callback callback) {
        callback.onError("NOT_SUPPORTED", graphUnavailable());
    }

    @Override
    public void identify(String accessoryId, Callback callback) {
        callback.onError("NOT_SUPPORTED", graphUnavailable());
    }

    private static String graphUnavailable() {
        return "this build can commission Matter accessories but cannot read "
                + "or control them; see SmartHome.getConfigurationProblems()";
    }

    // ------------------------------------------------------------------
    // Commissioning
    // ------------------------------------------------------------------

    @Override
    public int commissioningStyle() {
        return availability() == AVAIL_COMMISSIONING_ONLY ? STYLE_OS_OWNED_UI
                : STYLE_APP_HANDOFF;
    }

    @Override
    public void commission(String setupPayload, String structureId,
            String roomId, String suggestedName, int timeoutMillis,
            final Callback callback) {
        final Activity activity = AndroidNativeUtil.getActivity();
        if (activity == null || !(activity instanceof CodenameOneActivity)) {
            callback.onError("COMMISSIONING_UNAVAILABLE",
                    "there is no activity to run the add-device flow in");
            return;
        }
        if (pendingCommission != null) {
            // Play services shows one add-device UI at a time, and a second
            // request would replace the parked callback so the first caller
            // never heard anything. Refused, which is a failure they can see.
            callback.onError("BUSY",
                    "an add-device flow is already running");
            return;
        }
        CommissioningRequest.Builder request = CommissioningRequest.builder();
        if (setupPayload != null && setupPayload.length() > 0) {
            // Skips the scan step for a code the app already read. Play
            // services validates it and falls back to asking the user when it
            // does not like it, so a bad payload costs a step rather than the
            // whole flow.
            request.setOnboardingPayload(setupPayload);
        }
        if (suggestedName != null && suggestedName.length() > 0) {
            request.setDeviceNameHint(suggestedName);
        }
        pendingCommission = callback;
        final CommissioningRequest built = request.build();
        Matter.getCommissioningClient(activity)
                .commissionDevice(built)
                .addOnSuccessListener(new OnSuccessListener<IntentSender>() {
                    @Override
                    public void onSuccess(IntentSender sender) {
                        launch(activity, sender);
                    }
                })
                .addOnFailureListener(new OnFailureListener() {
                    @Override
                    public void onFailure(Exception failure) {
                        Callback waiting = pendingCommission;
                        pendingCommission = null;
                        if (waiting != null) {
                            waiting.onError("COMMISSIONING_FAILED",
                                    failure.getMessage());
                        }
                    }
                });
    }

    private void launch(Activity activity, IntentSender sender) {
        CodenameOneActivity cn1 = (CodenameOneActivity) activity;
        cn1.setIntentResultListener(new IntentResultListener() {
            @Override
            public void onActivityResult(int requestCode, int resultCode,
                    Intent data) {
                if (requestCode != REQUEST_COMMISSION) {
                    return;
                }
                Callback waiting = pendingCommission;
                pendingCommission = null;
                if (waiting == null) {
                    return;
                }
                if (resultCode != Activity.RESULT_OK) {
                    // By far the most common outcome, and not an error worth
                    // dressing as one: people change their mind halfway up a
                    // ladder.
                    waiting.onError("USER_CANCELED",
                            "the user closed the add-device screen");
                    return;
                }
                try {
                    CommissioningResult result =
                            CommissioningResult.fromIntentSenderResult(
                                    resultCode, data);
                    // No accessory id, and that is the point. The device
                    // joined the user's Google Home and this app is told its
                    // name and nothing more -- which is what
                    // CommissioningResult.wasCommissionedToThisApp() exists to
                    // make un-missable on the Java side.
                    String name = result.getDeviceName() == null ? ""
                            : result.getDeviceName();
                    waiting.onSuccess(new String[] {"\t" + name + "\t\t0"});
                } catch (Exception badResult) {
                    waiting.onError("COMMISSIONING_FAILED",
                            badResult.getMessage());
                }
            }
        });
        try {
            activity.startIntentSenderForResult(sender, REQUEST_COMMISSION,
                    null, 0, 0, 0);
        } catch (IntentSender.SendIntentException cannotStart) {
            Callback waiting = pendingCommission;
            pendingCommission = null;
            if (waiting != null) {
                waiting.onError("COMMISSIONING_FAILED",
                        cannotStart.getMessage());
            }
        }
    }
}
