{
  "openapi": "3.1.0",
  "info": {
    "title": "API",
    "version": "1.0"
  },
  "tags": [
    {
      "name": "Notes"
    }
  ],
  "paths": {
    "/api/notes/{id}": {
      "get": {
        "tags": [
          "Notes"
        ],
        "operationId": "get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Notes_Note"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request: a parameter or the body is missing, malformed or violates its constraints"
          }
        }
      },
      "delete": {
        "tags": [
          "Notes"
        ],
        "operationId": "delete",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request: a parameter or the body is missing, malformed or violates its constraints"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/api/notes": {
      "get": {
        "tags": [
          "Notes"
        ],
        "operationId": "list",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "X-Trace",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Notes_Page_Notes_Note"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request: a parameter or the body is missing, malformed or violates its constraints"
          }
        }
      },
      "post": {
        "tags": [
          "Notes"
        ],
        "operationId": "create",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Notes_Note"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Notes_Note"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request: a parameter or the body is missing, malformed or violates its constraints"
          }
        }
      }
    },
    "/api/files/{path}": {
      "get": {
        "tags": [
          "Notes"
        ],
        "operationId": "file",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request: a parameter or the body is missing, malformed or violates its constraints"
          }
        }
      }
    },
    "/api/orgs/{org}/count": {
      "get": {
        "tags": [
          "Notes"
        ],
        "operationId": "count",
        "parameters": [
          {
            "name": "org",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Notes_Note": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*",
            "maxLength": 80
          },
          "body_text": {
            "type": "string"
          },
          "stars": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 5
          },
          "color": {
            "type": "string",
            "enum": [
              "RED",
              "GREEN"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Notes_Tag"
            }
          },
          "counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "int32"
            }
          },
          "created": {
            "type": "integer",
            "format": "int64",
            "description": "milliseconds since the epoch"
          }
        },
        "required": [
          "title"
        ]
      },
      "Notes_Tag": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          }
        }
      },
      "Notes_Page_Notes_Note": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Notes_Note"
            }
          },
          "total": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    }
  }
}
