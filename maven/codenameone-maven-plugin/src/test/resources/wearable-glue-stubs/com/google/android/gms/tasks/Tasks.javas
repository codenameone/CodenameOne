package com.google.android.gms.tasks;
public class Tasks {
    public static <T> T await(Task<T> t) throws java.util.concurrent.ExecutionException,
            InterruptedException { return null; }
    public static <T> T await(Task<T> t, long timeout, java.util.concurrent.TimeUnit unit)
            throws java.util.concurrent.ExecutionException, InterruptedException,
            java.util.concurrent.TimeoutException { return null; }
    public static Task<java.util.List<Task<?>>> whenAllComplete(
            java.util.Collection<? extends Task<?>> tasks) { return null; }
    public static Task<java.util.List<Task<?>>> whenAllComplete(Task<?>... tasks) { return null; }
}
