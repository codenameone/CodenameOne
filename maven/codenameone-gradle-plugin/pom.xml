<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.codenameone</groupId>
        <artifactId>codenameone</artifactId>
        <version>8.0-SNAPSHOT</version>
    </parent>
    <artifactId>codenameone-gradle-plugin</artifactId>
    <name>Codename One Gradle Plugin</name>
    <description>The com.codenameone Gradle plugin: an optional, single-project Gradle build for Codename One applications, cn1libs and backends, running the same build engine as the Maven plugin</description>

    <!--
    Built by the Maven reactor, like everything else, so it is released through the
    same staging and lands in the same repository (repo.codenameone.com). Gradle finds
    it there through the plugin marker artifact, which is the sibling module
    codenameone-gradle-plugin-marker.

    The Gradle API comes from dev.gradleplugins:gradle-api, the API jar Gradle's own
    gradleApi() generates, republished to Maven Central. It is `provided`: the Gradle
    running the build supplies the real one. The plugin only uses API that is stable
    from Gradle 8.5 through 9.x, and targets Java 8 bytecode so the version check it
    performs can report a clear message instead of an UnsupportedClassVersionError.
    -->

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <gradle.api.version>8.11.1</gradle.api.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>codenameone-build-engine</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>codenameone-project-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The Gradle API, compiled against and supplied by Gradle at run time. Its
             groovy-all dependency is left out: 21 artifacts (Swing, console, SQL,
             test frameworks...) the plugin never touches, each one more download that
             a Maven Central outage can fail the build on (as it did, on groovy-swing).
             Core groovy stays, for the Closure types in the API's signatures. -->
        <dependency>
            <groupId>dev.gradleplugins</groupId>
            <artifactId>gradle-api</artifactId>
            <version>${gradle.api.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.codehaus.groovy</groupId>
                    <artifactId>groovy-all</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Test only: a test that fakes org.gradle.api.Task with a dynamic proxy
             needs every type the interface names, and Task.getAnt() names
             Gradle's AntBuilder, whose superclass is in groovy-ant (left out with
             groovy-all above). -->
        <dependency>
            <groupId>org.codehaus.groovy</groupId>
            <artifactId>groovy-ant</artifactId>
            <version>3.0.22</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>com/codename1/gradle/plugin.properties</exclude>
                </excludes>
            </resource>
            <!-- The plugin's own version, which is also the default Codename One
                 version a project builds against. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>com/codename1/gradle/plugin.properties</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.7.3.4</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Low</threshold>
                    <failOnError>false</failOnError>
                    <xmlOutput>true</xmlOutput>
                    <xmlOutputDirectory>${project.build.directory}</xmlOutputDirectory>
                    <excludeFilterFile>${project.basedir}/spotbugs-exclude.xml</excludeFilterFile>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>spotbugs</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
