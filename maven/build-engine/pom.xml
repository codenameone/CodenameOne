<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.codenameone</groupId>
        <artifactId>codenameone</artifactId>
        <version>8.0-SNAPSHOT</version>
    </parent>
    <artifactId>codenameone-build-engine</artifactId>
    <name>Codename One Build Engine</name>
    <description>The build-tool independent half of the Codename One build: the platform builders, cloud build submission, annotation processors, native-interface stubs and preflight checks. The Maven and Gradle plugins are adapters over it.</description>

    <!--
    Everything here was part of codenameone-maven-plugin and moved with its package
    names unchanged, so the plugin (which depends on this jar) and its tests did
    not change. The rule for what lives here: NO org.apache.maven type, anywhere.
    Logging goes through com.codename1.build.Log, which mirrors Maven's Log so the
    moved code only changed an import; failures are
    com.codename1.builders.BuildException. A class that needs MavenProject stays
    in the plugin.
    -->

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <!-- Overridden by -DskipTests; read by the proxy-jar copy below. -->
        <skipTests>false</skipTests>
    </properties>

    <dependencies>
        <!-- FIRST, before any port. Maven orders the test classpath by declaration,
             and codenameone-android brings the Android platform jar, whose junit.*
             classes are "Stub!" throwing stubs. Declared after it, JUnit 4 resolved to
             the stub and the Vintage engine failed to discover any test at all
             ("Failed to read version of junit:junit"). The Maven plugin's pom declares
             them in the same order. -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The backend's JVM database driver, so the bean tests can run the
             generated wiring of a transactional service against a real SQLite. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.0</version>
            <scope>test</scope>
        </dependency>
        <!-- JUnit 4 tests run through Surefire's JUnit Platform provider, which
             needs the Vintage engine or it silently reports zero tests. -->
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>codenameone-project-model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>codenameone-platform-feature-catalog</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>codenameone-build-hint-catalog</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>codenameone-build-hint-tools</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jdom</groupId>
            <artifactId>jdom2</artifactId>
            <version>2.0.6.1</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>codenameone-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>codenameone-css-cli</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>codenameone-svg-transcoder</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>codenameone-lottie-transcoder</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- For ResourceNames alone: the one rule that turns a nested resource
             path into the flat name it ships under. CompatResources applies it
             when it flattens a desktop application's resources and the runtime
             applies the same method when it looks one up. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>codenameone-compat-jdk</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>codenameone-android-res-compiler</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.ant</groupId>
            <artifactId>ant</artifactId>
        </dependency>
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-text</artifactId>
        </dependency>
        <dependency>
            <groupId>com.guardsquare</groupId>
            <artifactId>proguard-base</artifactId>
        </dependency>
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>cn1-binaries-javase</artifactId>
            <type>pom</type>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-vfs2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-util</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-commons</artifactId>
        </dependency>
        <dependency>
            <groupId>javassist</groupId>
            <artifactId>javassist</artifactId>
        </dependency>
        <dependency>
            <groupId>net.lingala.zip4j</groupId>
            <artifactId>zip4j</artifactId>
            <version>2.11.3</version>
        </dependency>

        <!-- The builders load their templates and the ports they stage from the
             classpath, so these are the engine's runtime dependencies, not any one
             build tool's. -->
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>java-runtime</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-javase</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>cn1-debug-proxy</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>cn1-builder-resources-common</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>cn1-builder-resources-android</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-android</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-ios</artifactId>
            <classifier>bundle</classifier>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-parparvm</artifactId>
            <classifier>bundle</classifier>
            <scope>runtime</scope>
        </dependency>
        <!-- WindowsPort, MacPort and LinuxPort bundles: the native platform classes
             and C / Objective-C sources the native desktop builders stage. -->
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-windows</artifactId>
            <classifier>bundle</classifier>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-mac</artifactId>
            <classifier>bundle</classifier>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-linux</artifactId>
            <classifier>bundle</classifier>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- Forces the reactor to build cn1-hardening first so its shaded jar can be
             embedded below; never on the classpath (see the plugin pom's history for
             the full reasoning behind provided + optional + wildcard exclusion). -->
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>cn1-hardening</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
            <optional>true</optional>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- RestControllerAnnotationProcessorTest compiles and RUNS the router it
             generates, which names HttpServer and Json. -->
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-backend</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The test support the backend test pass generates code against, so
             BackendTestGeneratorTest can start a generated context and run a test. -->
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-backend-test</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The desktop layers' real runtimes: DesktopEntryPointsTest compiles a
             Swing and a JavaFX fixture against them, remaps it and loads the
             main class the remap generated. -->
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-swing-compat</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-javafx-compat</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- SwingGallerySampleTest compiles scripts/desktop-compat-samples/swing-gallery
             the way that project's own build does: against the real SwingX,
             which the layer replaces, and the real MigLayout, which is bundled
             and relocated with the application. -->
        <dependency>
            <groupId>org.swinglabs.swingx</groupId>
            <artifactId>swingx-all</artifactId>
            <version>1.6.5-1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.miglayout</groupId>
            <artifactId>miglayout-swing</artifactId>
            <version>5.3</version>
            <scope>test</scope>
        </dependency>
        <!-- The headless implementation that test runs the remapped sample on.
             KEEP THIS LAST. The jar holds a com.codename1.impl.ImplementationFactory
             of its own, which a class loader that finds it before the core's
             starts Codename One on; the test builds such a loader from the jar
             file. On this module's own test classpath the core comes first, so
             every other test keeps the real factory. -->
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-compat-testing</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <!-- 2.22 silently skipped every JUnit test here under JDK 8. -->
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <!-- The forked app-hardening engine, embedded as /cn1-hardening.jar for
                         Executor to extract and run. prepare-package, because the shaded
                         'standalone' classifier only exists after cn1-hardening's package
                         phase, which a test-only partial reactor build never reaches. -->
                    <execution>
                        <id>embed-hardening-engine</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.codenameone</groupId>
                                    <artifactId>cn1-hardening</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>standalone</classifier>
                                    <type>jar</type>
                                    <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                                    <destFileName>cn1-hardening.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <overWriteReleases>true</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-updater-jar</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.outputDirectory}/com/codename1/maven"/>
                                <copy file="${maven.multiModuleProjectDirectory}/UpdateCodenameOne.jar"
                                      todir="${project.build.outputDirectory}/com/codename1/maven"/>
                            </target>
                        </configuration>
                    </execution>
                    <!-- JavaScriptProxyPackagerTest reads the JavaScript proxy jars from
                         the ParparVM bundle's build output. It moved here with the
                         builders, so the copy did too. -->
                    <execution>
                        <id>add-javascript-proxy-test-resources</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <!-- Only for the test that reads them. A -DskipTests install
                                 of this module alone, which the hellocodenameone test
                                 server does on every screenshot leg, failed here when
                                 ParparVM's bundle was not built, and its fallback then
                                 rebuilt every dependency: minutes per leg. -->
                            <skip>${skipTests}</skip>
                            <target>
                                <copy file="${maven.multiModuleProjectDirectory}/parparvm/target/bundle/javascript-proxy-javax.jar"
                                      todir="${project.build.testOutputDirectory}"/>
                                <copy file="${maven.multiModuleProjectDirectory}/parparvm/target/bundle/javascript-proxy-jakarta.jar"
                                      todir="${project.build.testOutputDirectory}"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.7.3.4</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Low</threshold>
                    <failOnError>false</failOnError>
                    <xmlOutput>true</xmlOutput>
                    <xmlOutputDirectory>${project.build.directory}</xmlOutputDirectory>
                    <excludeFilterFile>${project.basedir}/spotbugs-exclude.xml</excludeFilterFile>
                    <maxHeap>1536</maxHeap>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>spotbugs</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
