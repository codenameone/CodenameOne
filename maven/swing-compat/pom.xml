<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <parent>
        <groupId>com.codenameone</groupId>
        <artifactId>codenameone</artifactId>
        <version>8.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>codenameone-swing-compat</artifactId>
    <version>8.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>codenameone-swing-compat</name>
    <description>
        The java.awt, javax.swing, java.beans and SwingX APIs
        implemented on top of Codename One components, so desktop
        Swing code runs on devices. The JDK owns those package names,
        so an application keeps compiling against the JDK's own
        classes and this module is authored directly under the names
        it ships as, com.codename1.desktopcompat.*; the remap step of
        the build plugins rewrites the application's references to
        match.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.7.3.4</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Low</threshold>
                    <failOnError>false</failOnError>
                    <xmlOutput>true</xmlOutput>
                    <xmlOutputDirectory>${project.build.directory}</xmlOutputDirectory>
                    <excludeFilterFile>${project.basedir}/spotbugs-exclude.xml</excludeFilterFile>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>spotbugs</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- The JDK classes desktop code expects and the device runtime lacks.
             Compile scope on purpose: an application depends on this module
             alone, and the remap step finds the shared classes through it. -->
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-compat-jdk</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The headless Codename One implementation the tests run on. -->
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-compat-testing</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The real SwingX, for SwingXApiShapeTest alone: the layer's
             org.jdesktop classes are held to its signatures. Test scope on
             purpose; nothing the module ships may name it. -->
        <dependency>
            <groupId>org.swinglabs.swingx</groupId>
            <artifactId>swingx-all</artifactId>
            <version>1.6.5-1</version>
            <scope>test</scope>
        </dependency>
        <!-- The real FlatLaf and RSyntaxTextArea, for the API shape tests
             alone: the layer's com.formdev.flatlaf and org.fife classes are
             held to their signatures. Test scope on purpose; nothing the
             module ships may name them. RSyntaxTextArea is the last line
             that is Java 8 bytecode, which is what these tests run on. -->
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>3.7.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf-extras</artifactId>
            <version>3.7.1</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.fifesoft</groupId>
            <artifactId>rsyntaxtextarea</artifactId>
            <version>3.6.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
