import java.util.*;

public class JavascriptStorageHarness {
    private static final Map<String, String> gates = new HashMap<String, String>();
    private static final Storage storage = new Storage();
    private static boolean refuseLegacyDelete;
    private static boolean throwLegacyDelete;
    private static boolean laterWriter;
    private static int scenarios;

    static class Log {
        static final int WARNING = 1;
        static void p(String ignored, int level) { }
    }
    static class Storage {
        final Map<String, Object> values = new HashMap<String, Object>();
        static Storage getInstance() { return storage; }
        boolean writeObject(String key, Object value) { values.put(key, value); return true; }
        void deleteStorageFile(String key) {
            if (key.startsWith("legacy.")) {
                if (laterWriter) {
                    values.put("encrypted.account", "sealed:later");
                    gates.put("encrypted.account", "sealed:later");
                }
                if (throwLegacyDelete) throw new IllegalStateException("injected deletion failure");
                if (refuseLegacyDelete) return;
            }
            values.remove(key);
        }
    }
    private static String encryptedKey(String account) { return "encrypted." + account; }
    private static String legacyKey(String account) { return "legacy." + account; }
    private static Object readUncached(String key) { return storage.values.get(key); }
    private static boolean definitelyGone(String key) { return !storage.values.containsKey(key); }
    private static String reasonOf(RuntimeException failure) { return failure.getMessage(); }
    private static String seal(String account, String value) { return "sealed:" + value; }
    private static boolean gateAccepted(byte[] answer) { return answer[0] == 0; }
    private static byte[] nativeSet(String entry, String value) {
        gates.put(entry, value); return new byte[] {0};
    }
    private static byte[] nativeForgetIf(String entry, String expected) {
        if (expected.equals(gates.get(entry))) gates.remove(entry);
        return new byte[] {0};
    }
    private static void check(boolean condition, String message) {
        if (!condition) throw new AssertionError(message);
    }

    public static void verify() {
        JavascriptStorageHarness h = new JavascriptStorageHarness();
        for (boolean encrypted : new boolean[] {false, true}) {
            for (boolean throwing : new boolean[] {false, true}) {
                for (boolean concurrent : new boolean[] {false, true}) {
                    storage.values.clear(); gates.clear();
                    storage.values.put("legacy.account", "legacy-key");
                    if (encrypted) {
                        storage.values.put("encrypted.account", "sealed:old-key");
                        gates.put("encrypted.account", "sealed:old-key");
                    }
                    refuseLegacyDelete = true;
                    throwLegacyDelete = throwing;
                    laterWriter = concurrent;
                    check(!h.set("account", "candidate"), "failed legacy cleanup must fail set");
                    check("legacy-key".equals(storage.values.get("legacy.account")),
                            "legacy key must remain recoverable");
                    String expected = concurrent ? "sealed:later" : encrypted ? "sealed:old-key" : null;
                    check(Objects.equals(expected, storage.values.get("encrypted.account")),
                            "failed replacement must preserve the prior or later mirror");
                    check(!"sealed:candidate".equals(gates.get("encrypted.account")),
                            "gate must not retain the failed replacement");
                    if (concurrent) check("sealed:later".equals(gates.get("encrypted.account")),
                            "rollback must not remove a later writer's gate");
                    refuseLegacyDelete = false; throwLegacyDelete = false; laterWriter = false;
                    check(h.set("account", "retry"), "a retry must succeed");
                    check("sealed:retry".equals(storage.values.get("encrypted.account")),
                            "successful retry must install its value");
                    check(!storage.values.containsKey("legacy.account"), "retry must remove plaintext");
                    scenarios++;
                }
            }
        }
        check(scenarios == 8, "all eight failure and concurrency combinations must run");
    }

    /* PRODUCTION_METHODS */
}
