import java.io.IOException;
import java.lang.reflect.Constructor;
import java.lang.reflect.Method;
import java.util.concurrent.*;
import java.util.concurrent.atomic.AtomicBoolean;
import androidx.camera.core.Preview.SurfaceProvider;

/** CameraX doubles enforce its main-thread contract, with a separate CN1 caller thread. */
public class AndroidCameraThreadingHarness {
    private static volatile Thread uiThread;
    private static final ExecutorService ui = Executors.newSingleThreadExecutor(r -> {
        Thread thread = new Thread(r, "Android main");
        thread.setDaemon(true);
        uiThread = thread;
        return thread;
    });
    private static final Activity testActivity = new Activity();
    private static Activity registeredActivity = testActivity;
    private static boolean failDispatch;
    private static boolean deferDispatch;
    private static Runnable deferredTeardown;
    private static final java.util.Set<UseCase> boundCases = new java.util.HashSet<>();
    private static boolean failPreview;
    private static boolean failBind;
    private static boolean delayProvider;
    private static Runnable delayedBinding;
    private static int binds;
    private static int unbinds;
    private static int liveBindings;
    private static int loggedErrors;

    /* PRODUCTION_FIELDS */

    public AndroidCameraThreadingHarness() { activity = testActivity; }

    /* PRODUCTION_METHODS */

    private static void check(boolean ok, String message) {
        if (!ok) throw new AssertionError(message);
    }
    private static void checkMain() {
        check(Thread.currentThread() == uiThread, "CameraX called outside Android main");
    }
    private static boolean ensureCameraXResolved() { return true; }
    private void requireCameraPermission() {}
    private void requireAudioPermission() {}
    private void installFrameAnalyzer() {}
    private CameraInfo[] enumerateCameras() { return new CameraInfo[] {new CameraInfo(), new CameraInfo()}; }

    private static void reset() {
        registeredActivity = testActivity;
        failDispatch = false;
        deferDispatch = false;
        deferredTeardown = null;
        boundCases.clear();
        failPreview = false;
        failBind = false;
        delayProvider = false;
        delayedBinding = null;
        binds = unbinds = liveBindings = loggedErrors = 0;
        clsProcessCameraProvider = Provider.class;
        clsCameraSelector = Selector.class;
        clsCameraSelectorBuilder = Selector.Builder.class;
        clsPreview = PreviewUseCase.class;
        clsPreviewBuilder = PreviewUseCase.Builder.class;
        clsImageCaptureBuilder = Capture.Builder.class;
        clsImageAnalysisBuilder = Analysis.Builder.class;
        clsPreviewView = PreviewView.class;
        clsUseCase = UseCase.class;
        clsLifecycleOwner = LifecycleOwner.class;
        clsProcessLifecycleOwner = ProcessLifecycleOwner.class;
        frontLensFacing = 0;
        backLensFacing = 1;
    }

    private static AndroidCameraThreadingHarness openCamera() throws Exception {
        AndroidCameraThreadingHarness camera = new AndroidCameraThreadingHarness();
        camera.open("back", new CameraSessionOptions());
        check(camera.previewView != null, "native preview must be ready when open returns");
        PeerComponent peer = camera.createPreviewPeer();
        check(peer != null && peer.view == camera.previewView, "missing preview peer");
        check(peer.creator == Thread.currentThread(), "CN1 peer must be created on caller thread");
        return camera;
    }

    public static void openAndClose() throws Exception {
        reset();
        AndroidCameraThreadingHarness camera = openCamera();
        ExecutorService executor = (ExecutorService) camera.cameraExecutor;
        camera.close();
        camera.close();
        check(unbinds == 1 && liveBindings == 0, "close must unbind exactly once before returning");
        check(executor.isShutdown(), "camera executor leaked");
        check(camera.createPreviewPeer() == null, "closed camera exposes a peer");
        check(loggedErrors == 0, "teardown swallowed an error");
        openCamera().close();
        check(binds == 2 && unbinds == 2, "camera cannot reopen cleanly");
    }

    public static void failedPreview() throws Exception {
        reset();
        failPreview = true;
        AndroidCameraThreadingHarness camera = new AndroidCameraThreadingHarness();
        try {
            camera.open("back", new CameraSessionOptions());
            throw new AssertionError("preview failure was swallowed");
        } catch (IOException expected) {
            check(expected.getCause() != null, "lost preview failure cause");
        }
        check(binds == 0, "bound camera after preview initialization failed");
        check(camera.cameraExecutor == null || ((ExecutorService) camera.cameraExecutor).isShutdown(), "failed open leaked executor");
        check(camera.createPreviewPeer() == null, "failed open exposes a peer");
        failPreview = false;
        openCamera().close();
        check(liveBindings == 0 && loggedErrors == 0, "retry did not clean up");
    }

    public static void failedBind() throws Exception {
        reset();
        failBind = true;
        AndroidCameraThreadingHarness camera = new AndroidCameraThreadingHarness();
        try {
            camera.open("back", new CameraSessionOptions());
            throw new AssertionError("bind failure was swallowed");
        } catch (IOException expected) {}
        check(unbinds == 1 && liveBindings == 0, "failed bind not cleaned up");
        check(camera.cameraExecutor == null || ((ExecutorService) camera.cameraExecutor).isShutdown(), "failed bind leaked executor");
        failBind = false;
        openCamera().close();
        check(liveBindings == 0 && loggedErrors == 0, "retry did not clean up");
    }

    private static void checkReleased(AndroidCameraThreadingHarness camera, ExecutorService executor) {
        check(executor.isShutdown(), "camera executor leaked");
        check(camera.cameraExecutor == null && camera.previewView == null && camera.camera == null
                && camera.preview == null && camera.imageCapture == null && camera.imageAnalysis == null
                && camera.cameraProvider == null, "native references retained after close");
    }

    public static void closeWithoutRegisteredActivity() throws Exception {
        reset();
        AndroidCameraThreadingHarness camera = openCamera();
        ExecutorService executor = (ExecutorService) camera.cameraExecutor;
        registeredActivity = null;
        camera.close();
        camera.close();
        check(unbinds == 1 && liveBindings == 0, "captured activity did not unbind on main thread");
        checkReleased(camera, executor);
        check(loggedErrors == 0, "close without global activity logged an error");
    }

    public static void failedCloseDispatch() throws Exception {
        reset();
        AndroidCameraThreadingHarness camera = openCamera();
        ExecutorService executor = (ExecutorService) camera.cameraExecutor;
        failDispatch = true;
        camera.close();
        camera.close();
        checkReleased(camera, executor);
        check(loggedErrors == 1, "dispatch failure must be reported once");
        check(unbinds == 0, "failed dispatch cannot claim hardware was unbound");
    }

    public static void interruptedClose() throws Exception {
        reset();
        AndroidCameraThreadingHarness camera = openCamera();
        ExecutorService executor = (ExecutorService) camera.cameraExecutor;
        Thread.currentThread().interrupt();
        try {
            camera.close();
            check(Thread.currentThread().isInterrupted(), "close discarded caller interruption");
            check(unbinds == 1 && liveBindings == 0, "interrupted close did not finish unbinding");
            checkReleased(camera, executor);
        } finally {
            Thread.interrupted();
        }
    }

    public static void closeFromMain() throws Exception {
        reset();
        final AndroidCameraThreadingHarness camera = openCamera();
        Future<?> result = ui.submit(() -> camera.close());
        result.get(2, TimeUnit.SECONDS);
        check(unbinds == 1 && liveBindings == 0, "main-thread close failed");
        check(loggedErrors == 0, "main-thread close swallowed an error");
    }

    public static void timedOutOpen() throws Exception {
        reset();
        delayProvider = true;
        AndroidCameraThreadingHarness camera = new AndroidCameraThreadingHarness();
        try {
            camera.open("back", new CameraSessionOptions());
            throw new AssertionError("open without provider did not time out");
        } catch (IOException expected) {
            check(expected.getMessage().contains("timed out"), "unexpected open failure");
        }
        check(camera.cameraExecutor == null || ((ExecutorService) camera.cameraExecutor).isShutdown(), "timeout leaked executor");
        check(delayedBinding != null, "provider callback not registered");
        ui.submit(delayedBinding).get(2, TimeUnit.SECONDS);
        check(binds == 0 && camera.previewView == null, "late callback reopened a closed camera");
        delayProvider = false;
        openCamera().close();
        check(liveBindings == 0 && loggedErrors == 0, "retry after timeout failed");
    }

    public static void blockedMainOpen() throws Exception {
        reset();
        CountDownLatch blocked = new CountDownLatch(1);
        CountDownLatch release = new CountDownLatch(1);
        ui.execute(() -> {
            blocked.countDown();
            try { release.await(); } catch (InterruptedException e) { throw new AssertionError(e); }
        });
        check(blocked.await(2, TimeUnit.SECONDS), "could not block main thread");
        ExecutorService caller = Executors.newSingleThreadExecutor();
        AndroidCameraThreadingHarness camera = new AndroidCameraThreadingHarness();
        Future<?> result = caller.submit(() -> {
            try {
                camera.open("back", new CameraSessionOptions());
                throw new AssertionError("blocked open succeeded");
            } catch (IOException expected) {
                check(expected.getMessage().contains("timed out"), "unexpected open failure");
            }
        });
        try {
            result.get(8, TimeUnit.SECONDS);
            check(camera.cameraExecutor == null, "timed-out open retained executor");
        } finally {
            release.countDown();
            // Drain both the late binding callback and queued cleanup, even on failure.
            ui.submit(() -> {}).get(2, TimeUnit.SECONDS);
            caller.shutdownNow();
        }
        check(binds == 0 && camera.cameraProvider == null && camera.preview == null,
                "late callback reopened or retained the timed-out camera");
        openCamera().close();
    }

    public static void deferredClose() throws Exception {
        reset();
        AndroidCameraThreadingHarness old = openCamera();
        ExecutorService executor = (ExecutorService) old.cameraExecutor;
        ExecutorService caller = Executors.newSingleThreadExecutor();
        deferDispatch = true;
        Future<?> result = caller.submit(() -> old.close());
        try {
            result.get(3, TimeUnit.SECONDS);
            check(executor.isShutdown(), "bounded close retained its executor");
            check(old.cameraProvider != null && old.preview != null,
                    "bounded close discarded native handles before queued unbind");
            deferDispatch = false;
            AndroidCameraThreadingHarness next = openCamera();
            ui.submit(deferredTeardown).get(2, TimeUnit.SECONDS);
            checkReleased(old, executor);
            check(liveBindings == 1, "old cleanup unbound the newer camera session");
            next.close();
            check(liveBindings == 0 && unbinds == 2, "session-specific cleanup failed");
        } finally {
            deferDispatch = false;
            if (!result.isDone() && deferredTeardown != null) {
                ui.submit(deferredTeardown).get(2, TimeUnit.SECONDS);
            }
            caller.shutdownNow();
        }
    }

    private static class CountingExecutor extends AbstractExecutorService {
        final java.util.concurrent.atomic.AtomicInteger shutdowns = new java.util.concurrent.atomic.AtomicInteger();
        public void shutdown() { shutdowns.incrementAndGet(); }
        public java.util.List<Runnable> shutdownNow() { shutdown(); return java.util.Collections.emptyList(); }
        public boolean isShutdown() { return shutdowns.get() != 0; }
        public boolean isTerminated() { return isShutdown(); }
        public boolean awaitTermination(long timeout, TimeUnit unit) { return isShutdown(); }
        public void execute(Runnable r) { throw new AssertionError("unexpected camera task"); }
    }

    public static void concurrentClose() throws Exception {
        ExecutorService callers = Executors.newFixedThreadPool(8);
        try {
            for (int attempt = 0; attempt < 100; attempt++) {
                reset();
                AndroidCameraThreadingHarness camera = openCamera();
                camera.cameraExecutor.shutdown();
                CountingExecutor executor = new CountingExecutor();
                camera.cameraExecutor = executor;
                CountDownLatch ready = new CountDownLatch(8);
                CountDownLatch start = new CountDownLatch(1);
                java.util.List<Future<?>> results = new java.util.ArrayList<>();
                for (int i = 0; i < 8; i++) {
                    results.add(callers.submit(() -> {
                        ready.countDown();
                        try { start.await(); } catch (InterruptedException e) { throw new AssertionError(e); }
                        camera.close();
                    }));
                }
                check(ready.await(2, TimeUnit.SECONDS), "close callers did not start");
                start.countDown();
                for (Future<?> result : results) result.get(3, TimeUnit.SECONDS);
                check(unbinds == 1 && executor.shutdowns.get() == 1,
                        "concurrent close took cleanup ownership more than once");
                checkReleased(camera, executor);
            }
        } finally {
            callers.shutdownNow();
        }
    }

    public static void shutdown() { ui.shutdownNow(); }

    public static class Context {
        public Context getApplicationContext() { return this; }
    }
    public static class Activity extends Context {
        public void runOnUiThread(Runnable r) {
            if (failDispatch) throw new IllegalStateException("injected dispatch failure");
            if (deferDispatch) { deferredTeardown = r; return; }
            if (Thread.currentThread() == uiThread) r.run();
            else ui.execute(r);
        }
    }
    public static class View {}
    public static class PreviewView extends View {
        public PreviewView(Context context) {
            checkMain();
            if (failPreview) throw new IllegalStateException("injected preview failure");
        }
        public SurfaceProvider getSurfaceProvider() { checkMain(); return new SurfaceProvider() {}; }
    }
    public static class PeerComponent {
        final View view;
        final Thread creator = Thread.currentThread();
        PeerComponent(View view) { this.view = view; }
        public static PeerComponent create(View view) { return new PeerComponent(view); }
    }
    public static class UseCase {}
    public static class PreviewUseCase extends UseCase {
        SurfaceProvider provider;
        public void setSurfaceProvider(SurfaceProvider p) { checkMain(); provider = p; }
        public static class Builder {
            public PreviewUseCase build() { return new PreviewUseCase(); }
        }
    }
    public static class Capture extends UseCase {
        public static class Builder { public Capture build() { return new Capture(); } }
    }
    public static class Analysis extends UseCase {
        public static class Builder {
            public Builder setTargetResolution(android.util.Size size) { return this; }
            public Builder setBackpressureStrategy(int strategy) { return this; }
            public Analysis build() { return new Analysis(); }
        }
    }
    public static class Selector {
        public static class Builder {
            public Builder requireLensFacing(int facing) { return this; }
            public Selector build() { return new Selector(); }
        }
    }
    public interface LifecycleOwner {}
    public static class ProcessLifecycleOwner {
        public static LifecycleOwner get() { return new LifecycleOwner() {}; }
    }
    public static class Provider {
        public static ProviderFuture getInstance(Context context) { return new ProviderFuture(); }
        public Object bindToLifecycle(LifecycleOwner owner, Selector selector, UseCase[] cases) {
            checkMain();
            check(((PreviewUseCase) cases[0]).provider != null, "camera bound without preview surface provider");
            binds++;
            java.util.Collections.addAll(boundCases, cases);
            liveBindings = boundCases.size() / 3;
            if (failBind) throw new IllegalStateException("injected bind failure");
            return new Object();
        }
        public void unbindAll() { checkMain(); unbinds++; boundCases.clear(); liveBindings = 0; }
        public void unbind(UseCase[] cases) {
            checkMain();
            unbinds++;
            for (UseCase useCase : cases) {
                check(useCase != null, "deferred cleanup lost its use case");
                boundCases.remove(useCase);
            }
            liveBindings = boundCases.size() / 3;
        }
    }
    public static class ProviderFuture {
        public void addListener(Runnable r, Executor executor) {
            if (delayProvider) delayedBinding = r;
            else executor.execute(r);
        }
        public Provider get() { return new Provider(); }
    }
    public static class Looper {
        public static Looper getMainLooper() { return new Looper(); }
    }
    public static class Handler {
        public Handler(Looper looper) {}
        public boolean post(Runnable r) { ui.execute(r); return true; }
    }
    public static class AndroidImplementation {
        public static Activity getActivity() { return registeredActivity; }
        /* UI_SYNC_METHOD */
    }
    public static class Log {
        public static void w(String tag, String message) {}
        public static void e(String tag, String message, Throwable error) { loggedErrors++; }
    }
    public static class CameraInfo {}
    public static class CameraSessionOptions {
        public boolean isCaptureAudio() { return false; }
        public int getPreviewWidth() { return 640; }
        public int getPreviewHeight() { return 480; }
    }
    public interface FrameListener {}
    public enum FrameFormat { JPEG }
}
