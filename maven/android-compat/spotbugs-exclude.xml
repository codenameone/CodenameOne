<?xml version="1.0" encoding="UTF-8"?>
<!--
    The compatibility runtime implements the Android API surface, so several
    patterns SpotBugs reports are the API's own shape: Android declares them and
    applications compile against them. Each exception below says why it is kept;
    everything else is fixed in code.
-->
<FindBugsFilter>
    <!--
        Android's getters and setters share arrays and objects by contract
        (Drawable.getBounds() is the live rect, Paint, Path and Matrix are
        mutable and passed around by reference), and the runtime's peers share
        state with their views on purpose. The core accepts the same patterns.
    -->
    <Match>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
            <Bug pattern="MS_EXPOSE_REP"/>
        </Or>
    </Match>

    <!--
        Public constant arrays and fields of the Android API: android.R.styleable,
        View's *_STATE_SET arrays, Build.SUPPORTED_ABIS, StateSet.NOTHING, and
        XmlPullParser.TYPES.
        Applications read them by name, so they stay public, static and arrays.
    -->
    <Match>
        <Or>
            <Package name="~android(\..*)?"/>
            <Class name="org.xmlpull.v1.XmlPullParser"/>
            <!-- The libraries' R classes (androidx.appcompat.R...), generated
                 like android.R from library-res. -->
            <Class name="~(androidx|com\.google\.android\.material)(\..*)?\.R(\$.*)?"/>
        </Or>
        <Or>
            <Bug pattern="MS_MUTABLE_ARRAY"/>
            <Bug pattern="MS_PKGPROTECT"/>
        </Or>
    </Match>

    <!-- android.R.attr, R.id, R.style...: the framework's resource classes are
         lower case, and so are the libraries' (androidx.appcompat.R.attr...). -->
    <Match>
        <Or>
            <Class name="~(android|(androidx|com\.google\.android\.material)(\..*)?)\.R\$.*"/>
            <!-- Manifest.permission and Manifest.permission_group, the same way. -->
            <Class name="~android\.Manifest\$.*"/>
        </Or>
        <Bug pattern="NM_CLASS_NAMING_CONVENTION"/>
    </Match>

    <!--
        Public and protected fields of the Android API (Rect.left, TypedValue.data,
        Message.what, LayoutParams.width...) that applications read and write and
        the runtime may not touch itself.
    -->
    <Match>
        <Or>
            <Package name="~android(\..*)?"/>
            <Package name="~org\.xmlpull\..*"/>
        </Or>
        <Or>
            <Bug pattern="URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD"/>
            <Bug pattern="UUF_UNUSED_PUBLIC_OR_PROTECTED_FIELD"/>
            <Bug pattern="UWF_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD"/>
        </Or>
    </Match>

    <!--
        Android documents null rather than an empty array for many results
        (File.list(), Bundle.getStringArray(), Cursor column lookups), and
        applications test for it.
    -->
    <Match>
        <Bug pattern="PZLA_PREFER_ZERO_LENGTH_ARRAYS"/>
    </Match>

    <!--
        AOSP's view constructors call overridable methods (setPadding, setBackground,
        setChecked...) so a subclass sees its own overrides during construction;
        applications rely on that order.
    -->
    <Match>
        <Package name="~(android|androidx|com\.google\.android\.material)(\..*)?"/>
        <Bug pattern="MC_OVERRIDABLE_METHOD_CALL_IN_CONSTRUCTOR"/>
    </Match>

    <!--
        The consequence of that order: a subclass field read while the superclass
        constructor runs. Each of these is null-guarded or a primitive whose
        default is the right answer (AnimationSet's property flags are cleared
        after the super constructor, as in AOSP).
    -->
    <Match>
        <Or>
            <Class name="android.view.animation.AnimationSet"/>
            <Class name="android.widget.RelativeLayout$LayoutParams"/>
            <Class name="android.widget.Switch"/>
        </Or>
        <Bug pattern="UR_UNINIT_READ_CALLED_FROM_SUPER_CONSTRUCTOR"/>
    </Match>

    <!--
        As in the core: casts follow a type check or a documented contract (a
        LayoutParams generated by the same group, getSystemService's typed
        answer). No cast relies on ClassCastException; scripts/check-cast-semantics.sh
        enforces that, because ParparVM's CHECKCAST does not throw.
    -->
    <Match>
        <Or>
            <Bug pattern="BC_UNCONFIRMED_CAST"/>
            <Bug pattern="BC_UNCONFIRMED_CAST_OF_RETURN_VALUE"/>
        </Or>
    </Match>

    <!--
        Codename One's Object.clone() copies nothing (it answers null on the iOS
        VM), so every clone() here builds its copy explicitly instead of calling
        super.clone().
    -->
    <Match>
        <Bug pattern="CN_IDIOM_NO_SUPER_CALL"/>
    </Match>

    <!-- AOSP declares AlertDialog implements DialogInterface although Dialog already does. -->
    <Match>
        <Class name="android.app.AlertDialog"/>
        <Bug pattern="RI_REDUNDANT_INTERFACES"/>
    </Match>

    <!-- View.isLayoutRtl and LinearLayoutManager.isLayoutRTL are both the
         platform's and AndroidX's own method names; neither can be renamed. -->
    <Match>
        <Or>
            <And>
                <Class name="android.view.View"/>
                <Method name="isLayoutRtl"/>
            </And>
            <And>
                <Class name="androidx.recyclerview.widget.LinearLayoutManager"/>
                <Method name="isLayoutRTL"/>
            </And>
        </Or>
        <Bug pattern="NM_CONFUSING"/>
    </Match>

    <!-- URLSpan.getURL is the Android method name; it is not a misspelling of getUrl. -->
    <Match>
        <Class name="android.text.style.URLSpan"/>
        <Bug pattern="NM_CONFUSING"/>
    </Match>

    <!-- ListView.FixedViewInfo is an inner (non-static) class in the Android API. -->
    <Match>
        <Class name="android.widget.ListView$FixedViewInfo"/>
        <Bug pattern="SIC_INNER_SHOULD_BE_STATIC"/>
    </Match>

    <!-- As in the core: SpotBugs misreads null checks after try/finally and lambdas here. -->
    <Match>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
    </Match>

    <!--
        Fields assigned by the lifecycle before any reader can run: a Message's
        target before it is sent, a cursor driver's query before arguments are
        bound, an AlertDialog's items before the list is shown, the runtime's
        base context in install(), a ValueAnimator's value map together with its
        values, an activity record's class name in its factory.
    -->
    <Match>
        <Or>
            <Class name="android.os.Message"/>
            <Class name="android.database.sqlite.SQLiteDirectCursorDriver"/>
            <Class name="android.app.AlertDialog"/>
            <Class name="android.animation.ValueAnimator"/>
            <Class name="com.codename1.androidcompat.runtime.AndroidRuntime"/>
            <Class name="com.codename1.androidcompat.runtime.AndroidApp$ActivityInfo"/>
        </Or>
        <Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/>
    </Match>

    <!-- Codename One runs the Android API on its single UI thread (as in the core). -->
    <Match>
        <Or>
            <Bug pattern="LI_LAZY_INIT_STATIC"/>
            <Bug pattern="LI_LAZY_INIT_UPDATE_STATIC"/>
        </Or>
    </Match>

    <!--
        Exact float comparisons that mirror AOSP: a setter skips a repaint when
        the value is unchanged, a translation is interpolated only when its ends
        differ, and RectF.equals compares coordinates with ==.
    -->
    <Match>
        <Or>
            <And>
                <Class name="android.view.View"/>
                <Or>
                    <Method name="setAlpha"/>
                    <Method name="setTranslationX"/>
                    <Method name="setTranslationY"/>
                </Or>
            </And>
            <And>
                <Class name="android.view.animation.TranslateAnimation"/>
                <Method name="applyTransformation"/>
            </And>
            <And>
                <Class name="android.graphics.RectF"/>
                <Method name="equals"/>
            </And>
        </Or>
        <Bug pattern="FE_FLOATING_POINT_EQUALITY"/>
    </Match>

    <!--
        textAllCaps and InputFilter.AllCaps change user-visible text, and
        Android upper-cases it in the device's locale, as these do. They never
        touch protocol tokens.
    -->
    <Match>
        <Or>
            <And>
                <Class name="android.widget.TextView"/>
                <Method name="displayText"/>
            </And>
            <And>
                <Class name="android.text.InputFilter$AllCaps"/>
                <Method name="filter"/>
            </And>
        </Or>
        <Bug pattern="DM_CONVERT_CASE"/>
    </Match>

    <!--
        Both the activity and its fragments must get onCreateOptionsMenu and
        onPrepareOptionsMenu, so the non-short-circuit | is deliberate.
    -->
    <Match>
        <Class name="android.app.ActivityThread"/>
        <Method name="buildOptionsMenu"/>
        <Bug pattern="NS_DANGEROUS_NON_SHORT_CIRCUIT"/>
    </Match>

    <!-- AOSP's fragment state machine: each state falls through to the next. -->
    <Match>
        <Class name="android.app.FragmentManagerImpl"/>
        <Method name="moveToState"/>
        <Or>
            <Bug pattern="SF_SWITCH_FALLTHROUGH"/>
            <Bug pattern="SF_SWITCH_NO_DEFAULT"/>
        </Or>
    </Match>

    <!-- ContentValues.getAsBoolean answers null for a missing or unconvertible value, by contract. -->
    <Match>
        <Class name="android.content.ContentValues"/>
        <Method name="getAsBoolean"/>
        <Bug pattern="NP_BOOLEAN_RETURN_NULL"/>
    </Match>

    <!--
        The runtime does not show context menus yet, so showContextMenu() has no
        effect today; openContextMenu still routes through it so it takes effect
        when they are.
    -->
    <Match>
        <Class name="android.app.Activity"/>
        <Method name="openContextMenu"/>
        <Bug pattern="RV_RETURN_VALUE_IGNORED_NO_SIDE_EFFECT"/>
    </Match>

    <!--
        An AnimationSet's copy copies its children, and each child is copied by
        its own clone(): an application's Animation subclass overrides it.
    -->
    <Match>
        <Class name="android.view.animation.AnimationSet"/>
        <Method name="clone"/>
        <Bug pattern="MC_OVERRIDABLE_METHOD_CALL_IN_CLONE"/>
    </Match>

    <!-- AOSP's protected mRandomizer: created once per controller and reused for every child. -->
    <Match>
        <Class name="android.view.animation.LayoutAnimationController"/>
        <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/>
    </Match>
    <!--
        AppCompat's AlertDialog shares the framework dialog's simple name by API, and
        extends it here so the framework builder creates and shows it.
    -->
    <Match>
        <Class name="androidx.appcompat.app.AlertDialog"/>
        <Bug pattern="NM_SAME_SIMPLE_NAME_AS_SUPERCLASS"/>
    </Match>
    <!--
    The AndroidX fragment classes extend the platform's, so that one fragment
    engine runs both: androidx.fragment.app.Fragment is an
    android.app.Fragment, its manager and transaction extend the platform's,
    and the nested back stack types extend the platform's nested types. The
    names are AndroidX's own and cannot change. FragmentActivity's
    onAttachFragment(androidx Fragment) is AndroidX's overload, called from the
    platform one.
    -->
    <Match>
        <Or>
            <Class name="androidx.fragment.app.Fragment" />
            <Class name="androidx.fragment.app.Fragment$SavedState" />
            <Class name="androidx.fragment.app.FragmentManager" />
            <Class name="androidx.fragment.app.FragmentManager$BackStackEntry" />
            <Class name="androidx.fragment.app.FragmentManager$OnBackStackChangedListener" />
            <Class name="androidx.fragment.app.FragmentTransaction" />
        </Or>
        <Or>
            <Bug pattern="NM_SAME_SIMPLE_NAME_AS_SUPERCLASS" />
            <Bug pattern="NM_SAME_SIMPLE_NAME_AS_INTERFACE" />
        </Or>
    </Match>
    <Match>
        <Class name="androidx.fragment.app.FragmentActivity" />
        <Method name="onAttachFragment" />
        <Bug pattern="NM_WRONG_PACKAGE_INTENTIONAL" />
    </Match>
    <!--
    Vendored AOSP ConstraintLayout (androidx.constraintlayout:constraintlayout
    and the constraintlayout-core solver, Apache-2.0), third-party code kept as
    close to upstream as the Codename One runtime allows so later upstream fixes
    can be merged, as the core does for JBox2D. The Codename One adaptations in
    it (no reflection, Object.clone or regular expressions) were reviewed by
    hand; CLStrings, written for this port, is analysed like the rest of the
    runtime.
    -->
    <Match>
        <Package name="~androidx\.constraintlayout(\..*)?" />
        <Not>
            <Class name="androidx.constraintlayout.widget.CLStrings" />
        </Not>
    </Match>
    <!--
        RecyclerView.ItemAnimator.ItemHolderInfo.changeFlags is AndroidX's
        public field: the runtime records the adapter change flags in it for
        an application's item animator to read; nothing in the runtime does.
    -->
    <Match>
        <Class name="androidx.recyclerview.widget.RecyclerView$ItemAnimator$ItemHolderInfo"/>
        <Field name="changeFlags"/>
        <Bug pattern="URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD"/>
    </Match>
    <!--
        MaterialToolbar overrides setNavigationIcon to apply navigationIconTint,
        as Material's own does, and Toolbar's constructor calls it before the
        tint is read: the tint is then null, which MaterialAttrs.tinted treats
        as "leave the icon alone", and the constructor re-applies the icon once
        the tint is known.
    -->
    <Match>
        <Class name="com.google.android.material.appbar.MaterialToolbar"/>
        <Method name="setNavigationIcon"/>
        <Bug pattern="UR_UNINIT_READ_CALLED_FROM_SUPER_CONSTRUCTOR"/>
    </Match>
</FindBugsFilter>
