<?xml version="1.0" encoding="UTF-8"?>
<!--
  Differential tests of the ParparVM class library (vm/JavaAPI) against the JDK.

  Not shipped and not deployed. In process-classes, RelocateJavaApi compiles
  vm/JavaAPI/src and copies the classes under test into target/classes renamed
  java/... to jdkparity/java/..., so a test can run the JavaAPI implementation and
  the JDK's side by side in one JVM and compare what they do. References a
  relocated class makes to java.* classes that are NOT relocated stay on the JDK,
  so a JavaAPI class leaning on API the JDK lacks fails here too.

  It also copies com.codename1.impl.JdkHost (unrenamed), the superclass of the
  core's CoreJdkHost, so the core can install its host in test scope.

  Plain ASM rather than build-engine's ClassRelocator: depending on build-engine
  drags every port into the reactor with -am, and ClassRelocator also applies the
  desktop CompatRewrites, which are not under test here.

  Runs in PR CI with core-unittests (pr.yml, build-test job). Enabled by
  -DunitTests through the unittests profile in maven/pom.xml.

  No double dash inside these comments: XML forbids one.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.codenameone</groupId>
        <artifactId>codenameone</artifactId>
        <version>8.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>codenameone-jdk-parity-tests</artifactId>
    <packaging>jar</packaging>
    <name>Codename One JDK Parity Tests</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
        <javaapi.src.dir>${project.basedir}/../../vm/JavaAPI/src</javaapi.src.dir>
        <!-- The classes renamed under jdkparity/. Each name takes its nested
             classes with it. A slice adds the classes it tests here. -->
        <jdkparity.relocate>java/util/Optional,java/util/prefs/Preferences,java/util/prefs/BackingStoreException,java/util/logging/Logger,java/util/logging/Level,java/net/URL,java/net/MalformedURLException,java/security/MessageDigest,java/security/SecureRandom,java/security/GeneralSecurityException,java/security/NoSuchAlgorithmException,java/util/ResourceBundle,java/util/PropertyResourceBundle,java/util/ListResourceBundle,java/util/MissingResourceException,java/util/ServiceLoader,java/util/ServiceConfigurationError,java/util/StringJoiner,java/util/UUID,java/util/Base64,java/util/HexFormat,java/util/WeakHashMap,java/util/EventObject,java/util/Properties,java/io/UncheckedIOException,java/lang/MatchException,java/lang/reflect/InvocationTargetException,java/io/BufferedReader,java/io/BufferedWriter,java/io/BufferedInputStream,java/io/BufferedOutputStream,java/io/PrintWriter,java/nio/file/AccessDeniedException,java/nio/file/CopyOption,java/nio/file/DirectoryIteratorException,java/nio/file/DirectoryNotEmptyException,java/nio/file/DirectoryStream,java/nio/file/FileAlreadyExistsException,java/nio/file/FileSystemException,java/nio/file/FileVisitOption,java/nio/file/FileVisitResult,java/nio/file/FileVisitor,java/nio/file/Files,java/nio/file/Glob,java/nio/file/InvalidPathException,java/nio/file/LinkOption,java/nio/file/NoSuchFileException,java/nio/file/NotDirectoryException,java/nio/file/OpenOption,java/nio/file/Path,java/nio/file/PathImpl,java/nio/file/Paths,java/nio/file/SimpleFileVisitor,java/nio/file/StandardCopyOption,java/nio/file/StandardOpenOption,java/nio/file/attribute/BasicFileAttributes,java/nio/file/attribute/FileAttribute,java/nio/file/attribute/FileTime,
            ${jdkparity.relocate.function},
            ${jdkparity.relocate.stream},
            ${jdkparity.relocate.collections},
            ${jdkparity.relocate.concurrent}</jdkparity.relocate>
        <!-- The executors, futures and concurrent collections, with their
             package private helpers; their tests live in the relocated
             package, jdkparity.java.util.concurrent, to reach those. TimeUnit
             and the atomics stay the JDK's. -->
        <jdkparity.relocate.concurrent>java/util/concurrent/AbstractExecutorService,
            java/util/concurrent/AsyncPool,java/util/concurrent/BlockingWait,java/util/concurrent/Callable,
            java/util/concurrent/CancellationException,java/util/concurrent/CompletableFuture,
            java/util/concurrent/CompletionException,java/util/concurrent/CompletionStage,
            java/util/concurrent/ConcurrentHashMap,java/util/concurrent/ConcurrentMap,
            java/util/concurrent/CopyOnWriteArrayList,java/util/concurrent/CopyOnWriteArraySet,
            java/util/concurrent/CountDownLatch,java/util/concurrent/Delayed,java/util/concurrent/Delays,
            java/util/concurrent/ExecutionException,java/util/concurrent/Executor,
            java/util/concurrent/ExecutorService,java/util/concurrent/Executors,java/util/concurrent/Future,
            java/util/concurrent/FutureTask,java/util/concurrent/RejectedExecutionException,
            java/util/concurrent/RunnableFuture,java/util/concurrent/ScheduledExecutorService,
            java/util/concurrent/ScheduledFuture,java/util/concurrent/ScheduledPool,
            java/util/concurrent/ThreadFactory,java/util/concurrent/TimeoutException</jdkparity.relocate.concurrent>
        <!-- What List.of, Set.of, Map.of, their copyOf forms, Map.ofEntries
             and Map.entry delegate to. It is package private, so its test
             lives in the relocated package, jdkparity.java.util. -->
        <jdkparity.relocate.collections>java/util/ImmutableCollections</jdkparity.relocate.collections>
        <!-- The whole stream package and the value types its terminal
             operations answer. Spliterator stays the JDK's, so a JDK
             collection's spliterator() feeds the relocated StreamSupport. -->
        <jdkparity.relocate.stream>java/util/stream/BaseStream,java/util/stream/Stream,
            java/util/stream/Collector,java/util/stream/Collectors,
            java/util/stream/IntStream,java/util/stream/LongStream,java/util/stream/DoubleStream,
            java/util/stream/ObjPipeline,java/util/stream/IntPipeline,
            java/util/stream/LongPipeline,java/util/stream/DoublePipeline,
            java/util/stream/StreamState,java/util/stream/PullIterator,
            java/util/stream/StreamSupport,
            java/util/OptionalInt,java/util/OptionalLong,java/util/OptionalDouble,
            java/util/IntSummaryStatistics,java/util/LongSummaryStatistics,
            java/util/DoubleSummaryStatistics,java/util/DoubleSum,
            java/util/PrimitiveIterator</jdkparity.relocate.stream>
        <!-- The primitive function interfaces. Function, Predicate, Consumer and
             the other object-typed ones stay the JDK's: renamed, they would no
             longer be what the JDK collections the relocated code calls accept. -->
        <jdkparity.relocate.function>java/util/function/BiPredicate,java/util/function/BooleanSupplier,
            java/util/function/DoubleBinaryOperator,java/util/function/DoubleConsumer,
            java/util/function/DoubleFunction,java/util/function/DoublePredicate,
            java/util/function/DoubleSupplier,java/util/function/DoubleToIntFunction,
            java/util/function/DoubleToLongFunction,java/util/function/DoubleUnaryOperator,
            java/util/function/IntBinaryOperator,java/util/function/IntConsumer,
            java/util/function/IntFunction,java/util/function/IntPredicate,
            java/util/function/IntSupplier,java/util/function/IntToDoubleFunction,
            java/util/function/IntToLongFunction,java/util/function/IntUnaryOperator,
            java/util/function/LongBinaryOperator,java/util/function/LongConsumer,
            java/util/function/LongFunction,java/util/function/LongPredicate,
            java/util/function/LongSupplier,java/util/function/LongToDoubleFunction,
            java/util/function/LongToIntFunction,java/util/function/LongUnaryOperator,
            java/util/function/ObjDoubleConsumer,java/util/function/ObjIntConsumer,
            java/util/function/ObjLongConsumer,java/util/function/ToDoubleBiFunction,
            java/util/function/ToDoubleFunction,java/util/function/ToIntBiFunction,
            java/util/function/ToIntFunction,java/util/function/ToLongBiFunction,
            java/util/function/ToLongFunction</jdkparity.relocate.function>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-commons</artifactId>
        </dependency>
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-core</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.0.0</version>
                <executions>
                    <execution>
                        <id>relocate-javaapi</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.codename1.jdkparity.RelocateJavaApi</mainClass>
                            <classpathScope>compile</classpathScope>
                            <arguments>
                                <argument>${javaapi.src.dir}</argument>
                                <argument>${project.build.directory}/javaapi-classes</argument>
                                <argument>${project.build.outputDirectory}</argument>
                                <argument>${jdkparity.relocate}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.1</version>
                <configuration>
                    <!-- JdkHost is process-wide state; a fresh JVM per run. -->
                    <reuseForks>false</reuseForks>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
