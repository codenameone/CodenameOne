<?xml version="1.0" encoding="UTF-8"?>
<!--
  The server-side backend runtime, as an artifact.

  vm/backend holds one shared source tree and two implementations of the classes
  under it: impl/javase (JDK) and impl/parparvm (natives). This module publishes
  both halves, because a project needs each at a different moment.

    codenameone-backend                     shared + impl/javase, COMPILED.
                                            This is what a backend module compiles
                                            against and what `cn1:backend` runs on
                                            the JVM  -  the fast local loop.

    codenameone-backend:parparvm-sources    shared + impl/parparvm as SOURCE, plus
                                            the C the natives live in. This is what
                                            `cn1:backend-package` hands to the
                                            translator; it cannot be the compiled
                                            jar, because the translator reads
                                            bytecode compiled against vm/JavaAPI
                                            rather than against a JDK.

  Java 8 source and target: the shared half also has to compile against the
  JavaAPI bootclasspath on the translated side, and that surface is Java 8.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <parent>
        <groupId>com.codenameone</groupId>
        <artifactId>codenameone</artifactId>
        <version>8.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>codenameone-backend</artifactId>
    <packaging>jar</packaging>
    <name>Codename One Backend Runtime</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <backend.dir>${project.basedir}/../../vm/backend</backend.dir>
    </properties>

    <dependencies>
        <!-- Only for the local Java SE arm, and only for SQLite: the PostgreSQL
             and MySQL clients speak their wire protocols directly and need no
             driver. Optional so a project that uses neither pulls in nothing. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.0</version>
            <optional>true</optional>
        </dependency>
        <!--
             The tests here exercise the half of this runtime that is plain Java
             and needs no native: the dialect, the configuration, the pool, the
             ORM and the server builder. They run in the PR CI plugin leg, which
             builds this module with `-am` and therefore runs its tests; the
             translated arm and the server engines are covered separately, by
             vm/backend's demos under vm/tests.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
             TEST ONLY. The OpenTelemetry tracer encodes OTLP by hand, because the
             runtime is translated against a Java subset the protobuf library does
             not fit in. These are the classes opentelemetry-proto generates from
             the specification's own .proto files, and the tests decode every
             export with them: an encoder checked only against a decoder written
             beside it would agree with itself about any mistake.
        -->
        <dependency>
            <groupId>io.opentelemetry.proto</groupId>
            <artifactId>opentelemetry-proto</artifactId>
            <version>1.3.2-alpha</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>3.25.5</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${backend.dir}/src</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                         ONE JVM PER TEST CLASS, because this runtime has
                         process-global state by design and the tests are the
                         only place that is a problem.

                         EntityManager's registry of generated daos is static:
                         in a server the generated bootstrap fills it once at
                         start-up and it stays filled, which is correct there and
                         is why nothing clears it. In a shared test JVM it means
                         EntityManagerTest's registration is still there when
                         BackendTest asks whether a server with nothing
                         configured opens a database, and the answer becomes yes,
                         because a registered entity is one of the reasons to
                         open one.

                         That failed on the CI runner and passed locally purely
                         because surefire's default run order is the filesystem's.
                         A fork per class removes the order from the answer
                         rather than making one test tolerate the other; five
                         classes is five JVM starts, which is not measurable
                         beside the servers these tests bind.

                         (No double dash inside this comment: XML forbids one,
                         and maven reports it as a non-parseable POM.)
                    -->
                    <reuseForks>false</reuseForks>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-javase-implementation</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${backend.dir}/impl/javase</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>parparvm-sources-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- Source, not classes: the translator compiles
                                     these against vm/JavaAPI, which is a different
                                     bootclasspath from the one above. The C files
                                     ride along because a native's Java method is
                                     kept alive by its C symbol being present. -->
                                <jar destfile="${project.build.directory}/${project.build.finalName}-parparvm-sources.jar">
                                    <fileset dir="${backend.dir}/src" includes="**/*.java"/>
                                    <fileset dir="${backend.dir}/impl/parparvm" includes="**/*.java"/>
                                    <zipfileset dir="${backend.dir}/native" includes="*.c"
                                                prefix="cn1-native"/>
                                </jar>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-parparvm-sources</id>
                        <phase>package</phase>
                        <goals>
                            <goal>attach-artifact</goal>
                        </goals>
                        <configuration>
                            <artifacts>
                                <artifact>
                                    <file>${project.build.directory}/${project.build.finalName}-parparvm-sources.jar</file>
                                    <type>jar</type>
                                    <classifier>parparvm-sources</classifier>
                                </artifact>
                            </artifacts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
