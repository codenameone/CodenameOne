<?xml version="1.0" encoding="UTF-8"?>
<!--
  The server-side backend runtime, as an artifact.

  vm/backend holds one shared source tree and two implementations of the classes
  under it: impl/javase (JDK) and impl/parparvm (natives). This module publishes
  both halves, because a project needs each at a different moment.

    codenameone-backend                     shared + impl/javase, COMPILED.
                                            This is what a backend module compiles
                                            against and what `cn1:backend` runs on
                                            the JVM  -  the fast local loop.

    codenameone-backend:parparvm-sources    shared + impl/parparvm as SOURCE, plus
                                            the C the natives live in. This is what
                                            `cn1:backend-package` hands to the
                                            translator; it cannot be the compiled
                                            jar, because the translator reads
                                            bytecode compiled against vm/JavaAPI
                                            rather than against a JDK.

  Java 8 source and target: the shared half also has to compile against the
  JavaAPI bootclasspath on the translated side, and that surface is Java 8.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <parent>
        <groupId>com.codenameone</groupId>
        <artifactId>codenameone</artifactId>
        <version>8.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>codenameone-backend</artifactId>
    <packaging>jar</packaging>
    <name>Codename One Backend Runtime</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <backend.dir>${project.basedir}/../../vm/backend</backend.dir>
        <core.src.dir>${project.basedir}/../../CodenameOne/src</core.src.dir>
        <backend.shared.dir>${project.build.directory}/generated-sources/backend-shared</backend.shared.dir>
    </properties>

    <dependencies>
        <!-- Only for the local Java SE arm, and only for SQLite: the PostgreSQL
             and MySQL clients speak their wire protocols directly and need no
             driver. Optional so a project that uses neither pulls in nothing. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.0</version>
            <optional>true</optional>
        </dependency>
        <!--
             The tests here exercise the half of this runtime that is plain Java
             and needs no native: the dialect, the configuration, the pool, the
             ORM and the server builder. They run in the PR CI plugin leg, which
             builds this module with `-am` and therefore runs its tests; the
             translated arm and the server engines are covered separately, by
             vm/backend's demos under vm/tests.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
             TEST ONLY. The OpenTelemetry tracer encodes OTLP by hand, because the
             runtime is translated against a Java subset the protobuf library does
             not fit in. These are the classes opentelemetry-proto generates from
             the specification's own .proto files, and the tests decode every
             export with them: an encoder checked only against a decoder written
             beside it would agree with itself about any mistake.
        -->
        <dependency>
            <groupId>io.opentelemetry.proto</groupId>
            <artifactId>opentelemetry-proto</artifactId>
            <version>1.3.2-alpha</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>3.25.5</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${backend.dir}/src</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                         ONE JVM PER TEST CLASS, because this runtime has
                         process-global state by design and the tests are the
                         only place that is a problem.

                         EntityManager's registry of generated daos is static:
                         in a server the generated bootstrap fills it once at
                         start-up and it stays filled, which is correct there and
                         is why nothing clears it. In a shared test JVM it means
                         EntityManagerTest's registration is still there when
                         BackendTest asks whether a server with nothing
                         configured opens a database, and the answer becomes yes,
                         because a registered entity is one of the reasons to
                         open one.

                         That failed on the CI runner and passed locally purely
                         because surefire's default run order is the filesystem's.
                         A fork per class removes the order from the answer
                         rather than making one test tolerate the other; five
                         classes is five JVM starts, which is not measurable
                         beside the servers these tests bind.

                         (No double dash inside this comment: XML forbids one,
                         and maven reports it as a non-parseable POM.)
                    -->
                    <reuseForks>false</reuseForks>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-javase-implementation</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${backend.dir}/impl/javase</source>
                                <source>${backend.shared.dir}</source>
                            </sources>
                        </configuration>
                    </execution>
                    <!--
                         One declaration per plugin: Maven 3.10 refuses a POM that
                         declares the same plugin twice, where 3.9 only warned and
                         merged them, so every execution of it belongs here.
                    -->
                    <execution>
                        <id>attach-parparvm-sources</id>
                        <phase>package</phase>
                        <goals>
                            <goal>attach-artifact</goal>
                        </goals>
                        <configuration>
                            <artifacts>
                                <artifact>
                                    <file>${project.build.directory}/${project.build.finalName}-parparvm-sources.jar</file>
                                    <type>jar</type>
                                    <classifier>parparvm-sources</classifier>
                                </artifact>
                            </artifacts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <!--
                             The classes the app and the server share (the ORM,
                             the entity annotations) have ONE copy, in
                             CodenameOne/src, marked with
                             @com.codename1.impl.SharedWithBackend on a line of its
                             own. They are copied out of the core here rather than
                             kept under vm/backend, which is what they used to be:
                             sixty hand-synchronised duplicates.

                             vm/backend/shared-sources.sh is the same selection for
                             the shell builds; the line match below and its grep
                             must agree. Both refuse a backend source that shadows
                             a core one, so a copy cannot creep back in.
                        -->
                        <id>copy-shared-core-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <fail message="A source under vm/backend has the same package and class name as one in CodenameOne/src. Delete the backend copy and mark the core class @com.codename1.impl.SharedWithBackend, or give server-only behaviour a different class name. vm/backend/shared-sources.sh names the file.">
                                    <condition>
                                        <resourcecount when="greater" count="0">
                                            <union>
                                                <fileset dir="${backend.dir}/src" includes="**/*.java">
                                                    <present present="both" targetdir="${core.src.dir}"/>
                                                </fileset>
                                                <fileset dir="${backend.dir}/impl/javase" includes="**/*.java">
                                                    <present present="both" targetdir="${core.src.dir}"/>
                                                </fileset>
                                                <fileset dir="${backend.dir}/impl/parparvm" includes="**/*.java">
                                                    <present present="both" targetdir="${core.src.dir}"/>
                                                </fileset>
                                            </union>
                                        </resourcecount>
                                    </condition>
                                </fail>
                                <!-- Cleared first, so a class whose marker was
                                     removed does not linger from an earlier run. -->
                                <delete dir="${backend.shared.dir}"/>
                                <copy todir="${backend.shared.dir}">
                                    <fileset dir="${core.src.dir}" includes="**/*.java">
                                        <containsregexp expression="^@(com\.codename1\.impl\.)?SharedWithBackend\s*$"/>
                                    </fileset>
                                </copy>
                                <fail message="No core source is marked @com.codename1.impl.SharedWithBackend; the backend cannot compile without the shared ORM classes.">
                                    <condition>
                                        <resourcecount when="equal" count="0">
                                            <fileset dir="${backend.shared.dir}" includes="**/*.java"/>
                                        </resourcecount>
                                    </condition>
                                </fail>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>parparvm-sources-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- Source, not classes: the translator compiles
                                     these against vm/JavaAPI, which is a different
                                     bootclasspath from the one above. The C files
                                     ride along because a native's Java method is
                                     kept alive by its C symbol being present. -->
                                <jar destfile="${project.build.directory}/${project.build.finalName}-parparvm-sources.jar">
                                    <fileset dir="${backend.dir}/src" includes="**/*.java"/>
                                    <fileset dir="${backend.dir}/impl/parparvm" includes="**/*.java"/>
                                    <fileset dir="${backend.shared.dir}" includes="**/*.java"/>
                                    <zipfileset dir="${backend.dir}/native" includes="*.c"
                                                prefix="cn1-native"/>
                                </jar>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                 The same static analysis gates as the core, because this is
                 published API too and ParparVM translates it the same way.
                 PR CI (.github/workflows/pr.yml, Java 8 leg) runs `verify` here and
                 .github/scripts/generate-quality-report.py enforces the reports:
                 SpotBugs has to come out empty, and the PMD and Checkstyle rules
                 it forbids for the core are forbidden here too.

                 The rulesets are the core's own files rather than copies, so the
                 two cannot drift apart. Only the SpotBugs exclusions are this
                 module's, because an exclusion is scoped to the class it excuses.

                 The shared core sources copied into generated-sources are left
                 out of PMD and Checkstyle: core-unittests analyses them where they
                 live, and a finding in them is the core's to fix. SpotBugs works
                 on bytecode and sees them regardless, which is harmless: the
                 core's gate already holds them at zero.
            -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.7.3.4</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Low</threshold>
                    <failOnError>true</failOnError>
                    <xmlOutput>true</xmlOutput>
                    <xmlOutputDirectory>${project.build.directory}</xmlOutputDirectory>
                    <excludeFilterFile>${project.basedir}/spotbugs-exclude.xml</excludeFilterFile>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>spotbugs</goal>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>3.21.0</version>
                <configuration>
                    <failOnViolation>false</failOnViolation>
                    <printFailingErrors>false</printFailingErrors>
                    <targetJdk>1.8</targetJdk>
                    <rulesets>
                        <ruleset>${project.basedir}/../core-unittests/pmd.xml</ruleset>
                    </rulesets>
                    <!-- The production impl/parparvm tree is analysed by
                         maven/backend-parparvm, which compiles it. It cannot be
                         added here: PMD reads the project's compile source roots,
                         a read-only parameter, and making impl/parparvm one would
                         compile both twins of every per-target class at once. -->
                    <excludeRoots>
                        <excludeRoot>${backend.shared.dir}</excludeRoot>
                    </excludeRoots>
                </configuration>
                <executions>
                    <execution>
                        <id>pmd</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>pmd</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <configLocation>${project.basedir}/../core-unittests/checkstyle.xml</configLocation>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <consoleOutput>false</consoleOutput>
                    <failsOnError>false</failsOnError>
                    <linkXRef>false</linkXRef>
                    <includeTestSourceDirectory>false</includeTestSourceDirectory>
                    <outputFile>${project.build.directory}/checkstyle-result.xml</outputFile>
                    <outputFileFormat>xml</outputFileFormat>
                    <sourceDirectories>
                        <sourceDirectory>${backend.dir}/src</sourceDirectory>
                        <sourceDirectory>${backend.dir}/impl/javase</sourceDirectory>
                        <sourceDirectory>${backend.dir}/impl/parparvm</sourceDirectory>
                    </sourceDirectories>
                </configuration>
                <executions>
                    <execution>
                        <id>validate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>checkstyle</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            The same opt-in Error Prone pass the core gets (see maven/core/pom.xml
            and .github/workflows/errorprone.yml), over the backend runtime.

            BanClassForName applies here for the same reason it applies there:
            the backend is translated by ParparVM, which cannot resolve a class by
            its name at run time, so a Class.forName that works on the JVM arm is
            a server binary that fails in production. It covers the Java SE
            implementation too, which is what the JVM arm compiles, because a
            behaviour that exists only there is exactly the drift parity-check.sh
            is written to catch.
        -->
        <profile>
            <id>errorprone</id>
            <properties>
                <errorprone.version>2.27.1</errorprone.version>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <source>1.8</source>
                            <target>1.8</target>
                            <encoding>UTF-8</encoding>
                            <showWarnings>true</showWarnings>
                            <!--
                                Fork the compiler so the -J flags below
                                reach a fresh javac JVM. Without forking,
                                javac runs in the Maven process and the
                                module exports never apply, leaving
                                Error Prone's BaseErrorProneJavaCompiler
                                unable to access jdk.compiler internals.
                            -->
                            <fork>true</fork>
                            <compilerArgs combine.children="append">
                                <arg>-XDcompilePolicy=simple</arg>
                                <!--
                                    -XepDisableAllChecks turns off Error
                                    Prone's built-in rules so only the
                                    checks we explicitly enable run. The
                                    framework targets Java 1.5/1.8 idioms
                                    and many built-in checks would fire on
                                    legacy code we have no intention of
                                    rewriting today.
                                -->
                                <arg>-Xplugin:ErrorProne -XepDisableAllChecks -Xep:BanClassForName:ERROR</arg>
                                <!-- JDK 16+ closes javac internals; Error
                                     Prone needs these to introspect the
                                     AST. The -J prefix routes each flag to
                                     the forked javac JVM. -->
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
                                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
                                <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                                <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                            </compilerArgs>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>com.google.errorprone</groupId>
                                    <artifactId>error_prone_core</artifactId>
                                    <version>${errorprone.version}</version>
                                </path>
                                <path>
                                    <groupId>com.codenameone</groupId>
                                    <artifactId>errorprone-checks</artifactId>
                                    <version>${project.version}</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
