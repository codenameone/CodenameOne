+// ---- TYPED PAGES (vm/BIBOP-INVARIANTS.md R10-R13) --------------------------
+// Fed only by CN1_FAST_NEW, whose size is sizeof(struct obj__X) and therefore
+// canonical, which satisfies R12/R13 by construction rather than by a check.
+// Pages are typed at format time only (R10) and untyped on the way out.
+static int bibopNextAllocIndex = 1;   // bibopMutex; 0 means unassigned
+extern int classListSize;
+
+static CN1BibopPage** cn1BibopThreadTypedTable(struct ThreadLocalData* d, int idx) {
+    if(idx < d->bibopCurrentByClassLen) {
+        return d->bibopCurrentByClass;
+    }
+    int grow = classListSize + 16;
+    if(grow <= idx) {
+        grow = idx * 2 + 16;
+    }
+    CN1BibopPage** n = (CN1BibopPage**)realloc(d->bibopCurrentByClass,
+                                               (size_t)grow * sizeof(CN1BibopPage*));
+    if(n == 0) {
+        return 0;
+    }
+    memset(n + d->bibopCurrentByClassLen, 0,
+           (size_t)(grow - d->bibopCurrentByClassLen) * sizeof(CN1BibopPage*));
+    d->bibopCurrentByClass = n;
+    d->bibopCurrentByClassLen = grow;
+    return n;
+}
+
+// Release every typed page this thread is holding IDLE. Called once per cycle,
+// from the acquisition path, because a typed page is owned and an owned page is
+// invisible to the sweep (R6). Without this a thread accumulates one un-sweepable
+// page per class it has ever allocated -- 17 of 23 pages on hashMapChurn -- and
+// the collector stops reclaiming anything on a small heap.
+//
+// The pages go to the sweep stack exactly as a retired page does; the next
+// allocation of that class simply acquires a fresh one.
+static void cn1BibopReleaseIdleTypedPages(CODENAME_ONE_THREAD_STATE) {
+    for(int ai = 0 ; ai < threadStateData->bibopCurrentByClassLen ; ai++) {
+        CN1BibopPage* tp = threadStateData->bibopCurrentByClass[ai];
+        if(tp == 0) {
+            continue;
+        }
+        tp->owned = JAVA_FALSE;   // R6: only retired pages may reach the sweep
+        tp->pageClazz = 0;        // R11: untyped while it still holds its objects
+        CN1BibopPage* sh = atomic_load_explicit(&bibopSweepStack, memory_order_relaxed);
+        do {
+            tp->nextPool = sh;
+        } while(!atomic_compare_exchange_weak_explicit(&bibopSweepStack, &sh, tp,
+                    memory_order_release, memory_order_relaxed));
+        threadStateData->bibopCurrentByClass[ai] = 0;
+    }
+}
+
+static CN1BibopPage* cn1BibopAcquireTypedPage(CODENAME_ONE_THREAD_STATE, int ci,
+                                              struct clazz* parent) {
+    // R9: the ordinary acquisition path consults the GC trigger on every page.
+    // Skipping it here would let typed pages grow the heap without pacing.
+    cn1BibopMaybeGc(threadStateData);
+    // Bound the pinned set to one cycle (see cn1BibopReleaseIdleTypedPages).
+    if(threadStateData->bibopTypedEpoch != currentGcMarkValue) {
+        threadStateData->bibopTypedEpoch = currentGcMarkValue;
+        pthread_mutex_lock(&bibopMutex);
+        cn1BibopReleaseIdleTypedPages(threadStateData);
+        pthread_mutex_unlock(&bibopMutex);
+    }
+    pthread_mutex_lock(&bibopMutex);
+    int ai = parent->cn1AllocIndex;
+    if(ai == 0) {
+        ai = bibopNextAllocIndex;
+        parent->cn1AllocIndex = ai;
+        parent->cn1AllocCi = ci;   // R13: the one size this class is typed for
+        bibopNextAllocIndex = ai + 1;
+    } else if(parent->cn1AllocCi != ci) {
+        // Same class, different width. Never retype: the existing page is full of
+        // correctly sized objects, and oscillating between two sizes would retire
+        // a page on every allocation.
+        pthread_mutex_unlock(&bibopMutex);
+        return 0;
+    }
+    CN1BibopPage** tbl = cn1BibopThreadTypedTable(threadStateData, ai);
+    if(tbl == 0) {
+        pthread_mutex_unlock(&bibopMutex);
+        return 0;
+    }
+    CN1BibopPage* old = tbl[ai];
+    if(old != 0) {
+        old->owned = JAVA_FALSE;   // R6: only retired pages may reach the sweep
+        old->pageClazz = 0;        // R11: untyped on the way out, while it still holds its objects
+        CN1BibopPage* sh = atomic_load_explicit(&bibopSweepStack, memory_order_relaxed);
+        do {
+            old->nextPool = sh;
+        } while(!atomic_compare_exchange_weak_explicit(&bibopSweepStack, &sh, old,
+                    memory_order_release, memory_order_relaxed));
+        tbl[ai] = 0;
+    }
+    // R10: EMPTY pages only -- never a partial one, which would already hold
+    // objects of other classes below the bump cursor.
+    CN1BibopPage* np = 0;
+    if(bibopFreePool != 0) {
+        np = bibopFreePool;
+        bibopFreePool = np->nextPool;
+        cn1BibopFormatPage(np, ci);
+    }
+    pthread_mutex_unlock(&bibopMutex);
+    if(np == 0) {
+        np = cn1BibopNewPage(ci);
+        if(np == 0) {
+            return 0;
+        }
+    }
+    np->owned = JAVA_TRUE;   // R5: this thread is the single cursor
+    np->nextPool = 0;
+    np->pageClazz = parent;
+    tbl[ai] = np;
+    return np;
+}
+
+// Exported shim: the inline fast path in the header cannot see a static.
+struct CN1BibopPage* cn1BibopAcquireTypedPageExt(CODENAME_ONE_THREAD_STATE, int ci,
+                                                 struct clazz* parent) {
+    return cn1BibopAcquireTypedPage(threadStateData, ci, parent);
+}
