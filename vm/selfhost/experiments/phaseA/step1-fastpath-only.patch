+            do {
+                old->nextPool = sh;
+            } while(!atomic_compare_exchange_weak_explicit(&bibopSweepStack, &sh, old,
+                        memory_order_release, memory_order_relaxed));
+            threadStateData->bibopCurrentByClass[ai] = 0;
+        }
+    }
+    if(threadStateData->bibopCurrentByClass != 0) {
+        free(threadStateData->bibopCurrentByClass);
+        threadStateData->bibopCurrentByClass = 0;
+        threadStateData->bibopCurrentByClassLen = 0;
+    }
 }
 #endif /* CN1_DISABLE_BIBOP */
 
