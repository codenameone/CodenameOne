+// ---- TYPED PAGES, STEP 1: the fixed-size fast path only --------------------
+// One class per page, so a later step can delete the class pointer from every
+// object header and read it off the page instead. The slot histogram prices that
+// at 8.9% of allocated bytes on the selfhost corpus and it is the only header
+// field whose removal is free -- per-PAGE metadata amortises over ~2048 slots,
+// per-SLOT metadata does not (REGISTRY Round 36).
+//
+// SCOPE, deliberately small. Only CN1_FAST_NEW feeds these pages. It always asks
+// for sizeof(struct obj__X), so the size is canonical by construction and the
+// "one class, one size class" invariant holds without a runtime check. That is
+// exactly what the first attempt got wrong: cn1AllocFused asks for the String
+// header PLUS its inlined characters, so class__java_lang_String_i8 allocates at
+// many sizes, and keyed by class alone a long string ran off the end of a slot
+// sized for a short one. Every other allocation path -- the general
+// cn1BibopAlloc, the fused natives, arrays -- keeps the shared size-classed
+// pages untouched, so none of them can reach this invariant.
+//
+// EMPTY PAGES ONLY. A page is typed at the moment it is formatted and never
+// afterwards: typing a partially filled page would leave foreign objects below
+// the bump cursor. So this takes a free/fresh page and never a partial one, and
+// clears pageClazz when the page is handed back.
+static int bibopNextAllocIndex = 1;   // 0 means UNASSIGNED; bibopMutex
+extern int classListSize;
+
+// Grow this thread's typed-page table to cover idx. NULL means "cannot type",
+// and every caller then falls back to the ordinary size-classed path.
+static CN1BibopPage** cn1BibopThreadTypedTable(struct ThreadLocalData* d, int idx) {
+    if(idx < d->bibopCurrentByClassLen) {
+        return d->bibopCurrentByClass;
+    }
+    int grow = classListSize + 16;   // slack: the String twins are not in that count
+    if(grow <= idx) {
+        grow = idx * 2 + 16;
+    }
+    CN1BibopPage** n = (CN1BibopPage**)realloc(d->bibopCurrentByClass,
+                                               (size_t)grow * sizeof(CN1BibopPage*));
+    if(n == 0) {
+        return 0;
+    }
+    memset(n + d->bibopCurrentByClassLen, 0,
+           (size_t)(grow - d->bibopCurrentByClassLen) * sizeof(CN1BibopPage*));
+    d->bibopCurrentByClass = n;
+    d->bibopCurrentByClassLen = grow;
+    return n;
+}
+
+// Retire this thread's typed page for `parent` and install a freshly formatted
+// one. Returns the new page, or 0 to mean "could not type -- use the shared
+// path", which is always safe because the object header still carries its class.
+static CN1BibopPage* cn1BibopAcquireTypedPage(CODENAME_ONE_THREAD_STATE, int ci,
+                                              struct clazz* parent) {
+    pthread_mutex_lock(&bibopMutex);
+    int ai = parent->cn1AllocIndex;
+    if(ai == 0) {
+        ai = bibopNextAllocIndex;
+        parent->cn1AllocIndex = ai;
+        bibopNextAllocIndex = ai + 1;
+    }
+    CN1BibopPage** tbl = cn1BibopThreadTypedTable(threadStateData, ai);
+    if(tbl == 0) {
+        pthread_mutex_unlock(&bibopMutex);
+        return 0;
+    }
+    CN1BibopPage* old = tbl[ai];
+    if(old != 0) {
+        old->owned = JAVA_FALSE;
+        // Untyped again on the way out. The page keeps its live objects and goes
+        // back into general circulation, where a mix is expected; nothing reads a
+        // class off a page yet, and when something does, only pages typed at
+        // format time will be eligible.
+        old->pageClazz = 0;
+        CN1BibopPage* sh = atomic_load_explicit(&bibopSweepStack, memory_order_relaxed);
+        do {
+            old->nextPool = sh;
+        } while(!atomic_compare_exchange_weak_explicit(&bibopSweepStack, &sh, old,
+                    memory_order_release, memory_order_relaxed));
+        tbl[ai] = 0;
+    }
+    // FREE pages only -- never bibopPartialPool. A partial page already holds
+    // objects of other classes.
+    CN1BibopPage* np = 0;
+    if(bibopFreePool != 0) {
+        np = bibopFreePool;
+        bibopFreePool = np->nextPool;
+        cn1BibopFormatPage(np, ci);
+    }
+    pthread_mutex_unlock(&bibopMutex);
+    if(np == 0) {
+        np = cn1BibopNewPage(ci);
+        if(np == 0) {
+            return 0;
+        }
+    }
+    np->owned = JAVA_TRUE;
+    np->nextPool = 0;
+    np->pageClazz = parent;   // empty page, so every object in it will be `parent`
+    tbl[ai] = np;
+    return np;
+}
+
+#ifdef CN1_GC_VERIFY
+// THE INVARIANT, ASSERTED RATHER THAN ASSUMED: every object in a typed page is
+// an instance of that page's class. This is the whole basis for later deleting
+// the class pointer from the object header, so it is checked directly against
+// the header that is still there -- which is only possible while both exist.
+// Run it before the header is removed or it can never be run at all.
+void cn1GcVerifyTypedPages(void) {
+    long pages = 0, objs = 0, bad = 0;
+    CN1BibopPage* p = atomic_load_explicit(&bibopAllPages, memory_order_acquire);
+    while(p != 0) {
+        struct clazz* pc = p->pageClazz;
+        if(pc != 0) {
+            pages++;
+            int n = atomic_load_explicit(&p->bumpIndex, memory_order_acquire);
+            for(int i = 0 ; i < n ; i++) {
+                JAVA_OBJECT o = cn1BibopSlot(p, i);
+                int m = __atomic_load_n(&o->__codenameOneGcMark, __ATOMIC_ACQUIRE);
+                if(m == CN1_BIBOP_FREE_MARK) {
+                    continue;   // a freed slot carries a free-list pointer, not a class
+                }
+                objs++;
+                if(o->__codenameOneParentClsReference != pc) {
+                    if(bad < 10) {
+                        fprintf(stderr, "[TYPED-PAGE] slot %d of a %s page holds %s\n",
+                                i, pc->clsName != 0 ? pc->clsName : "?",
+                                o->__codenameOneParentClsReference != 0 &&
+                                o->__codenameOneParentClsReference->clsName != 0
+                                    ? o->__codenameOneParentClsReference->clsName : "?");
+                    }
+                    bad++;
+                }
+            }
+        }
+        p = atomic_load_explicit(&p->nextAll, memory_order_acquire);
+    }
+    fprintf(stderr, "[TYPED-PAGE] typedPages=%ld objects=%ld MISMATCHES=%ld\n",
+            pages, objs, bad);
+}
+#endif
+
+// Exported shim: the inline fast path in the header cannot see a static.
+struct CN1BibopPage* cn1BibopAcquireTypedPageExt(CODENAME_ONE_THREAD_STATE, int ci,
+                                                 struct clazz* parent) {
+    return cn1BibopAcquireTypedPage(threadStateData, ci, parent);
+}
