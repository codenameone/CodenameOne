<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.codename1.parparvm</groupId>
        <artifactId>parparvm-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>parparvm-tests</artifactId>
    <name>ParparVM Java Tests</name>

    <properties>
        <parparvm.test.forkCount>1C</parparvm.test.forkCount>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.codename1.parparvm</groupId>
            <artifactId>ByteCodeTranslator</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-commons</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-core</artifactId>
            <version>7.0.214</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-ios</artifactId>
            <version>7.0.214</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-ios</artifactId>
            <version>7.0.214</version>
            <classifier>bundle</classifier>
            <scope>test</scope>
        </dependency>
        <!-- The hellocodenameone app is Kotlin; buildHelloCodenameOneExe stages the
             Kotlin 1.6.0 stdlib (kotlin.Unit etc.) from ~/.m2 as a translator source
             root. Declaring it here ensures Maven resolves it into the local repo on
             every runner (it is otherwise absent, e.g. on the dev VM). jdk8 pulls
             jdk7 + stdlib + common transitively. -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib-jdk8</artifactId>
            <version>1.6.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-annotations-jvm</artifactId>
            <version>1.6.0</version>
            <scope>test</scope>
        </dependency>
        <!-- BackendOtelTest decodes what the TRANSLATED server exports with the
             classes generated from the OpenTelemetry specification's own .proto
             files, so the hand-written encoder is judged by the schema after it
             has been through ParparVM, not by a decoder written beside it. -->
        <dependency>
            <groupId>io.opentelemetry.proto</groupId>
            <artifactId>opentelemetry-proto</artifactId>
            <version>1.3.2-alpha</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>3.25.5</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- androidx (Compose runtime, collection, annotation) is published only to
         Google Maven; KotlinComposeIntegrationTest copies those jars. -->
    <repositories>
        <repository>
            <id>google</id>
            <url>https://maven.google.com</url>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/benchmark-dependencies</outputDirectory>
                            <includeGroupIds>com.codenameone</includeGroupIds>
                            <includeScope>test</includeScope>
                        </configuration>
                    </execution>
                    <!-- KotlinComposeIntegrationTest: Kotlin 2.4 coroutines + the Compose
                         runtime, and the compiler that builds its fixture. Copied as plain
                         files rather than declared as dependencies, because this module pins
                         kotlin-stdlib 1.6.0 on the test classpath for another test, and a
                         2.4 stdlib there would replace it. `copy` does not resolve
                         transitively, so every jar is listed. androidx artifacts come from
                         the Google repository declared below. -->
                    <execution>
                        <id>copy-kmp-runtime</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/kmp-runtime</outputDirectory>
                            <artifactItems>
                                <artifactItem><groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-stdlib</artifactId><version>2.4.21</version></artifactItem>
                                <artifactItem><groupId>org.jetbrains.kotlinx</groupId><artifactId>kotlinx-coroutines-core-jvm</artifactId><version>1.11.0</version></artifactItem>
                                <artifactItem><groupId>androidx.compose.runtime</groupId><artifactId>runtime-desktop</artifactId><version>1.12.1</version></artifactItem>
                                <artifactItem><groupId>androidx.compose.runtime</groupId><artifactId>runtime-annotation-jvm</artifactId><version>1.12.1</version></artifactItem>
                                <artifactItem><groupId>androidx.collection</groupId><artifactId>collection-jvm</artifactId><version>1.5.0</version></artifactItem>
                                <artifactItem><groupId>androidx.annotation</groupId><artifactId>annotation-jvm</artifactId><version>1.9.1</version></artifactItem>
                                <artifactItem><groupId>org.jetbrains</groupId><artifactId>annotations</artifactId><version>23.0.0</version></artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-kmp-compiler</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/kmp-compiler</outputDirectory>
                            <artifactItems>
                                <artifactItem><groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-compiler-embeddable</artifactId><version>2.4.21</version></artifactItem>
                                <artifactItem><groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-compose-compiler-plugin-embeddable</artifactId><version>2.4.21</version></artifactItem>
                                <artifactItem><groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-stdlib</artifactId><version>2.4.21</version></artifactItem>
                                <artifactItem><groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-script-runtime</artifactId><version>2.4.21</version></artifactItem>
                                <artifactItem><groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-daemon-embeddable</artifactId><version>2.4.21</version></artifactItem>
                                <artifactItem><groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-build-tools-api</artifactId><version>2.4.21</version></artifactItem>
                                <artifactItem><groupId>org.jetbrains.kotlinx</groupId><artifactId>kotlinx-coroutines-core-jvm</artifactId><version>1.8.0</version></artifactItem>
                                <artifactItem><groupId>org.jetbrains</groupId><artifactId>annotations</artifactId><version>13.0</version></artifactItem>
                                <artifactItem><groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-reflect</artifactId><version>1.6.10</version></artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- The in-tree Java compiler (vm/JavaCompiler), compiled into the tests so
                 JavaCompilerConformanceTest can hold it to javac. Its own artifact is
                 built by maven/javac, which this reactor does not reach. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>add-java-compiler-sources</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>../JavaCompiler/src</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <!-- Tests run on newer JDK (8+) so source/target 1.8 is appropriate here -->
                    <!-- But the code they test targets 1.5. The test runner itself needs to run on the JVM. -->
                    <source>1.8</source>
                    <target>1.8</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <!-- Run test classes across parallel JVM forks. Parallelism MUST be
                         process-level: the translator (Parser) keeps static mutable state,
                         so in-JVM thread parallelism would corrupt it. Each test writes to
                         unique createTempDirectory paths and the only shared path
                         (target/benchmark-dependencies) is populated by maven-dependency-plugin
                         before the test phase and only read here, so forks never collide.
                         1C = one fork per available CPU core. Timing and memory
                         benchmarks override this to 1 so their measurements are not
                         perturbed by other benchmark processes starting or finishing. -->
                    <forkCount>${parparvm.test.forkCount}</forkCount>
                    <reuseForks>true</reuseForks>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <!-- One exec file per surefire fork. surefire substitutes
                                 ${surefire.forkNumber} in the agent argLine per forked JVM;
                                 without this, parallel forks would clobber a single
                                 jacoco.exec and the coverage report would be corrupt/empty. -->
                            <destFile>${project.build.directory}/jacoco-fork-${surefire.forkNumber}.exec</destFile>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- Merge the per-fork exec files back into one before the report.
                             Declared before the report execution so it runs first in the
                             test phase. -->
                        <id>merge-forks</id>
                        <phase>test</phase>
                        <goals>
                            <goal>merge</goal>
                        </goals>
                        <configuration>
                            <fileSets>
                                <fileSet>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>jacoco-fork-*.exec</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                            <destFile>${project.build.directory}/jacoco.exec</destFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>isolated-benchmarks</id>
            <activation>
                <property><name>groups</name><value>benchmark</value></property>
            </activation>
            <properties>
                <!-- Each benchmark already drives its own workers and collector.
                     Competing benchmark JVMs distort GC pacing and working sets. -->
                <parparvm.test.forkCount>1</parparvm.test.forkCount>
            </properties>
        </profile>
    </profiles>
</project>
