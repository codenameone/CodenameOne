{
  "title": "Codename One backend",
  "uid": "cn1-backend-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "codenameone",
    "backend"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "description": "Built only from metrics every Codename One backend reports, on the JVM and as a packaged native server. See MetricSchema.",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      },
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(process_uptime, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(process_uptime{job=~\"$job\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "HTTP",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Requests per second, by route",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_route, http_request_method) (rate(http_server_request_duration_count{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{http_request_method}} {{http_route}}"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Latency p95, by route",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_bucket{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{http_route}}"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Server errors (5xx) per second",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_route) (rate(http_server_request_duration_count{job=~\"$job\", instance=~\"$instance\", http_response_status_code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{http_route}}"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Requests in flight and connections",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(http_server_active_requests{job=~\"$job\", instance=~\"$instance\"})",
          "legendFormat": "active requests"
        },
        {
          "refId": "B",
          "expr": "sum(http_server_open_connections{job=~\"$job\", instance=~\"$instance\"})",
          "legendFormat": "open connections"
        },
        {
          "refId": "C",
          "expr": "sum(cn1_server_websocket_connections{job=~\"$job\", instance=~\"$instance\"})",
          "legendFormat": "websockets"
        },
        {
          "refId": "D",
          "expr": "sum(rate(cn1_server_connections_refused{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "refused / s"
        }
      ],
      "id": 5
    },
    {
      "type": "row",
      "title": "Database pool",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Pool utilization",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(db_client_connection_count{job=~\"$job\", instance=~\"$instance\"} - db_client_connection_idle{job=~\"$job\", instance=~\"$instance\"}) / sum(db_client_connection_max{job=~\"$job\", instance=~\"$instance\"})",
          "legendFormat": "in use / max"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Borrowers waiting and timeouts",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(db_client_connection_pending_requests{job=~\"$job\", instance=~\"$instance\"})",
          "legendFormat": "waiting"
        },
        {
          "refId": "B",
          "expr": "sum(increase(db_client_connection_timeouts{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "timeouts"
        }
      ],
      "id": 8
    },
    {
      "type": "row",
      "title": "Executors and jobs",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Executor queue and active tasks",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cn1_executor) (cn1_task_queue_depth{job=~\"$job\", instance=~\"$instance\"})",
          "legendFormat": "queued {{cn1_executor}}"
        },
        {
          "refId": "B",
          "expr": "sum by (cn1_executor) (cn1_task_active{job=~\"$job\", instance=~\"$instance\"})",
          "legendFormat": "active {{cn1_executor}}"
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Scheduled job runs, by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cn1_job, cn1_outcome) (increase(cn1_scheduler_run_duration_count{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{cn1_job}} {{cn1_outcome}}"
        }
      ],
      "id": 11
    },
    {
      "type": "row",
      "title": "Process",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "Heap",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(process_runtime_memory_used{job=~\"$job\", instance=~\"$instance\"})",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "expr": "sum(process_runtime_memory_committed{job=~\"$job\", instance=~\"$instance\"})",
          "legendFormat": "committed"
        }
      ],
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "Uptime",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(process_uptime{job=~\"$job\", instance=~\"$instance\"})",
          "legendFormat": "uptime"
        }
      ],
      "id": 14
    }
  ]
}
