<?xml version="1.0" encoding="UTF-8"?>
<!--
  The shim generator, as a build-time tool.

  It is a module rather than a script so the app build can depend on it: the
  shims it writes are generated code and belong in target/, not in git.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.codenameone.devruntime</groupId>
        <artifactId>cn1-device-runtime</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>cn1-device-runtime-tools</artifactId>
    <name>cn1-device-runtime-tools</name>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
    </properties>

    <dependencies>
        <!--
          The framework is read, not linked against: the generator reflects over
          it to decide what can be subclassed.
        -->
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-core</artifactId>
            <version>${cn1.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <version>9.8</version>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-tree</artifactId>
            <version>9.8</version>
        </dependency>
    </dependencies>
</project>
