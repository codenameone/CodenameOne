<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- app-store, not ad-hoc: the weekly job feeds TestFlight. -->
    <key>method</key>
    <string>app-store</string>
    <!-- teamID is intentionally omitted: xcodebuild derives it from the
         provisioning profile embedded in the archive. The prior literal
         `$(APPLE_TEAM_ID)` was never substituted (plists are data, not
         shell) and the workflow does not carry the id as a secret, so
         Xcode failed to select a signing team during export. -->
    <key>uploadSymbols</key>
    <true/>
    <!-- The build is submitted by altool in a later step, so the archive export
         itself does not upload. -->
    <key>destination</key>
    <string>export</string>
</dict>
</plist>
