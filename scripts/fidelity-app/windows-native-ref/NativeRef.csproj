<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unpackaged, self-contained WinUI 3. MSIX is deliberately avoided: it needs a signing
    certificate, a sideloading policy and Add-AppxPackage, and all three behave differently
    on a Windows Server runner than on a Windows client one. That would make the reference
    set depend on runner policy rather than on the design language, which is the opposite
    of what this app is for. WindowsPackageType=None plus WindowsAppSDKSelfContained gives
    a folder you cd into and run.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Cn1NativeRef</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!--
      TRUE, which the official unpackaged WinUI 3 template also sets, despite the app being
      unpackaged. With it false no resources.pri is produced at all, and WinUI's own theme
      dictionary lives in one; the controls then fall back to unstyled defaults. Measured on
      run 34957156915, which captured a Button whose corner pixel and centre pixel were the
      same flat (194,194,194): a square grey rectangle, where a Fluent Button is #FDFDFD with
      4px rounded corners and a border. The capture looked perfectly plausible.
    -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!--
      Built with Visual Studio's MSBuild, not `dotnet build`. MrtCore.PriGen.targets
      resolves its tasks from
      $(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\AppxPackage\,
      and eight distinct tasks live in that Visual Studio assembly: ValidateConfiguration,
      GetPackageArchitecture, GetDefaultResourceLanguage, GetSdkFileFullPath,
      GetSdkPropertyValue, ExpandPayloadDirectories, RemovePayloadDuplicates and
      RemoveRedundantXamlFilesFromSdkPayload. Under `dotnet` that path is the .NET SDK
      directory, where the AppxPackage tooling has never shipped at any version.

      Disabling them one property at a time was tried and abandoned: each property that
      silenced one task simply revealed the next, and getting a build out that way would
      have meant switching off most of the resource pipeline and then wondering why the
      controls rendered unstyled.
    -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- App.xaml would otherwise generate its own entry point, which clashes with the
         explicit STAThread Main in Program.cs. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250228001" />
    <!-- Out of the box since .NET 7, and Windows only, which is exactly what this is.
         Used purely to turn the HBITMAP from BitBlt into a PNG. -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>
</Project>
