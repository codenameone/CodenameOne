<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unpackaged, self-contained WinUI 3. MSIX is deliberately avoided: it needs a signing
    certificate, a sideloading policy and Add-AppxPackage, and all three behave differently
    on a Windows Server runner than on a Windows client one. That would make the reference
    set depend on runner policy rather than on the design language, which is the opposite
    of what this app is for. WindowsPackageType=None plus WindowsAppSDKSelfContained gives
    a folder you cd into and run.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Cn1NativeRef</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- If MrtCore PRI generation still fails after the SDK pin in global.json, the next
         thing to try is EnableMsixTooling=true: the official unpackaged WinUI 3 template
         sets it true even though the app is unpackaged, because the MRT tooling is used
         regardless. Left false for now because the observed error named the .NET SDK 10
         layout specifically, and changing one thing at a time is what makes the next run
         interpretable. -->
    <EnableMsixTooling>false</EnableMsixTooling>
    <PublishReadyToRun>false</PublishReadyToRun>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250228001" />
  </ItemGroup>
</Project>
