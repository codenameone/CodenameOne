<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.codenameone.fidelity</groupId>
    <artifactId>fidelity-app</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <artifactId>fidelity-app-desktop-runner</artifactId>
  <name>fidelity-app-desktop-runner</name>

  <!--
    The HOST half of the desktop fidelity suite: it boots the JavaSE simulator in this
    JVM, renders the Codename One tiles for one desktop theme and writes them to disk.

    A module of its own rather than another class in `common`, and the reason is
    structural rather than tidiness. `common` is compiled as Codename One APPLICATION
    code and runs `bytecode-compliance`, which rejects anything outside the CN1 class
    library, so java.io.File, javax.imageio and java.awt.Container are all build
    failures there. Every one of them is unavoidable here:

      - Display.init() needs a real java.awt.Container on the JavaSE port. Passing
        null does not throw, it HANGS, which is how this was measured.
      - The tiles are written to a host directory for the comparator to read, which
        is not what FileSystemStorage addresses.

    Rewriting them in CN1 APIs to satisfy the gate would be defeating a check that is
    telling the truth: this is not application code and it never runs on a device.
  -->

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
  </properties>

  <dependencies>
    <!-- Cn1WidgetRenderer and the fidelity spec parser, shared with the device runners. -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>${cn1app.name}-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The simulator itself: the CN1 runtime this renders against. -->
    <dependency>
      <groupId>com.codenameone</groupId>
      <artifactId>codenameone-javase</artifactId>
      <version>${cn1.version}</version>
    </dependency>
  </dependencies>
</project>
