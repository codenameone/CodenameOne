<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The struct-cost measurement. A class library: the timing harness is Java
    (java/bench/BenchMain.java), so the same clock and the same loop bounds
    drive the translated C# and the two hand-written Java forms it is compared
    with.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>StructBench</AssemblyName>
    <RootNamespace>Bench</RootNamespace>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Bench.cs" />
  </ItemGroup>
</Project>
