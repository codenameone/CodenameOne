<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The independent half of the metadata reader's check. Prints an assembly
    through System.Reflection.Metadata in exactly the format
    com.codename1.cil.tools.MetadataDump prints it through our own reader.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
</Project>
