        <!--
          The platform modules (javase/, android/, ios/, javascript/, win/, linux/)
          are optional. The profiles from here to the end-marker let this module do
          the work of any of them the project does not have. A platform has a module
          of its own exactly when <root>/<platform>/pom.xml exists; when it does,
          every goal below steps aside and the module does the work, so adding one
          later never builds a platform twice. Requires codenameone-maven-plugin
          7.0.275 or newer.

          Each dependency here either has a version or is one the root pom manages
          (codenameone-core, codenameone-javase); not every root pom manages
          cn1-binaries-javase, so it carries ${cn1.version} itself.

          Native interface implementations go where they always have, for example
          ../android/src/main/java -  cn1:generate-native-interfaces creates the
          directory - and are picked up from there whether or not a pom sits beside
          them.
        -->
        <profile>
            <!-- The JavaSE native code (../javase/src/main/java), compiled into
                 target/cn1-javase/classes for the simulator, the tests and the
                 desktop builds, and the JUnit tests, which run here when there is
                 no javase module to run them. -->
            <id>cn1-javase-natives</id>
            <activation>
                <file>
                    <missing>${basedir}/../javase/pom.xml</missing>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.codenameone</groupId>
                        <artifactId>codenameone-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>compile-javase-natives</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>compile-javase-natives</goal>
                                </goals>
                                <configuration>
                                    <hostedPlatform>javase</hostedPlatform>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <!--
                          The root pom gives Surefire Codename One's provider, which runs nothing
                          (cn1:test runs the AbstractTest classes). On its own it hid every JUnit
                          test, so a failing @Test passed the build. This provider runs them.
                        -->
                        <dependencies>
                            <dependency>
                                <groupId>org.apache.maven.surefire</groupId>
                                <artifactId>surefire-junit-platform</artifactId>
                                <version>3.0.0-M5</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <skipTests>${skipTests}</skipTests>
                            <additionalClasspathElements>
                                <additionalClasspathElement>${project.build.directory}/cn1-javase/classes</additionalClasspathElement>
                            </additionalClasspathElements>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
