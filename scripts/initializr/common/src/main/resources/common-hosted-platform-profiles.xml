                                        <argument>@${cn1.hosted.classpathArgFile}</argument>
                                        <argument>${exec.mainClass}</argument>
                                        <argument>${codename1.mainClass}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
