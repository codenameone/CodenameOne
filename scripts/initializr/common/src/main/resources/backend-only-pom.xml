<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.example.myapp</groupId>
  <artifactId>myappname</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>myappname</name>

  <!--
    A Codename One backend: a server written in Java, run on the JVM while you
    develop it and shipped as a single native binary.

      ./mvnw cn1:backend
          runs it on this JVM, in seconds
      ./mvnw cn1:backend-package
          builds a native binary to deploy

    The routes are the @RestController classes under src/main/java. The build
    turns them into a router and the main that serves them.

    This project deliberately does NOT depend on codenameone-core: a server has no
    display, and the compiler saying so at the point of the import is more useful
    than a crash at start-up.
  -->
  <properties>
    <cn1.plugin.version>8.0-SNAPSHOT</cn1.plugin.version>
    <cn1.version>8.0-SNAPSHOT</cn1.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- The native build translates class files of this level. -->
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <cn1app.name>myappname</cn1app.name>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.codenameone</groupId>
      <artifactId>codenameone-backend</artifactId>
      <version>${cn1.version}</version>
    </dependency>
    <!--
         The SQLite driver for `cn1:backend`, the local JVM run. It is optional in
         codenameone-backend, so Maven does not pass it down here, and without it
         Database.open(":memory:") fails with "No suitable driver". The native build
         links SQLite in and does not use this. Delete it if this server never opens
         a SQLite database.
    -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.46.1.0</version>
      <scope>runtime</scope>
    </dependency>
    <!--
         @BackendTest, MockMvc and TestRestTemplate: Spring Boot's test layer,
         under Codename One's package names. The tests are JUnit 5. Add
         org.mockito:mockito-core here too to replace a bean with @MockitoBean;
         tests that use it run on the JVM only.
    -->
    <dependency>
      <groupId>com.codenameone</groupId>
      <artifactId>codenameone-backend-test</artifactId>
      <version>${cn1.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.9.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.8.0</version>
      </plugin>
      <plugin>
        <groupId>com.codenameone</groupId>
        <artifactId>codenameone-maven-plugin</artifactId>
        <version>${cn1.plugin.version}</version>
        <!--
             No <mainClass>: the entry point is generated from the @RestController
             classes. Set one only if this server writes its own main instead.
        -->
        <executions>
          <execution>
            <id>cn1-process-annotations</id>
            <phase>process-classes</phase>
            <goals>
              <!-- Generates a router and an entry point from any @RestController
                   class in this project. -->
              <goal>process-annotations</goal>
            </goals>
          </execution>
          <execution>
            <id>cn1-process-test-annotations</id>
            <phase>process-test-classes</phase>
            <goals>
              <!-- Generates the wiring each @BackendTest class runs against:
                   the production beans, with the test's @TestConfiguration
                   beans and mocks in place. -->
              <goal>process-test-annotations</goal>
            </goals>
          </execution>
          <execution>
            <id>cn1-compiled-tests</id>
            <phase>test</phase>
            <goals>
              <!-- Off unless -Dcn1.backend.compiledTests=true: then the same
                   tests are also translated into a native test binary and run,
                   which is how this server ships. -->
              <goal>backend-test</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.0.0-M5</version>
        <configuration>
          <!-- One server runs per process: a JVM per test class keeps one
               class's server and settings out of the next's. -->
          <reuseForks>false</reuseForks>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!--
      Codename One publishes its releases to the Codename One repository. Both lists
      are needed: Maven resolves ordinary dependencies through the repositories list
      and build plugins through the pluginRepositories list.
  -->
  <repositories>
    <repository>
      <id>codenameone</id>
      <url>https://repo.codenameone.com/maven2</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>codenameone-plugins</id>
      <url>https://repo.codenameone.com/maven2</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </pluginRepository>
  </pluginRepositories>
</project>
