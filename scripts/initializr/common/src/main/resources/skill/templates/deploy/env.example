# Codename One deployment template -- see ../../references/deployment.md.
# Replace myapp with the project's name and app.example.com with the domain. The binary
# is named after the backend module's artifactId: backend/target/myapp-backend here.
# Copy to /etc/myapp/env on the server (chmod 600, owner root). Never commit the real file.
# /etc/myapp/env -- chmod 600, owned by root
DATABASE_URL=postgres://myapp:CHANGE-ME@db.internal:5432/myapp?sslmode=require
CN1_SERVER_ADDRESS=127.0.0.1
CN1_SERVER_FORWARDHEADERS=true
CN1_SERVER_TRUSTEDPROXIES=127.0.0.1
CN1_SESSION_SECURE=true
CN1_MANAGEMENT_TOKEN=CHANGE-ME-TOO
