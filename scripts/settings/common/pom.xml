<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.codenameone.settings</groupId>
        <artifactId>cn1-settings</artifactId>
        <version>8.0-SNAPSHOT</version>
    </parent>
    <artifactId>cn1-settings-common</artifactId>
    <packaging>jar</packaging>

    <properties>
        <cn1.settings.skipTests>true</cn1.settings.skipTests>
    </properties>
    <name>cn1-settings-common</name>

    <dependencies>
        <!-- Build-time only: it runs the generator below and must never reach a
             built app, because it pulls in ASM and ParparVM parses every class
             in an app jar. -->
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-build-hint-tools</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-build-hint-catalog</artifactId>
        </dependency>
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-javase</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>javase</id>
            <activation>
                <property>
                    <name>codename1.platform</name>
                    <value>javase</value>
                </property>
            </activation>
            <properties>
                <codename1.targetPlatform>javase</codename1.targetPlatform>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.0.0</version>
                        <configuration>
                            <executable>java</executable>
                            <longClasspath>true</longClasspath>
                            <arguments>
                                <argument>-Xmx1024M</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>${exec.mainClass}</argument>
                                <argument>${cn1.mainClass}</argument>
                            </arguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <resources>
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <!-- The build hint data file, rendered from the annotations in
                 CodenameOne/src into this module's own classes. Generated rather
                 than checked in, because a committed generated file conflicts on
                 every merge and there is nothing for a hand edit to survive in.
                 classpathScope=compile so that build-hint-tools resolves from the
                 reactor: a plugin level dependency would have to come from the
                 repository, which is a chicken and egg on a clean checkout. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.0.0</version>
                <executions>
                    <execution>
                        <id>cn1-generate-build-hint-data</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.codename1.build.shared.BuildHintCodeGenerator</mainClass>
                            <classpathScope>compile</classpathScope>
                            <!-- combine.self=override so a plugin level
                                 configuration cannot merge into this one. The
                                 Settings module's javase profile declares this
                                 same plugin with its own <arguments> holding a
                                 <classpath/> element, and Maven merged that
                                 Object into this String array: "can not cast one
                                 of the elements of java.lang.Object[]". Only
                                 with -Dcodename1.platform=javase, which is why a
                                 plain local build never saw it. -->
                            <arguments combine.self="override">
                                <argument>${project.basedir}/../../../CodenameOne/src</argument>
                                <argument>${project.build.outputDirectory}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>properties-maven-plugin</artifactId>
                <version>1.0.0</version>
                <executions>
                    <execution>
                        <phase>initialize</phase>
                        <goals><goal>read-project-properties</goal></goals>
                        <configuration>
                            <files>
                                <file>${basedir}/codenameone_settings.properties</file>
                            </files>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.codenameone</groupId>
                <artifactId>codenameone-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>cn1-process-classes</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>bytecode-compliance</goal>
                            <goal>css</goal>
                            <goal>process-annotations</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>attach-test-artifact</id>
                        <phase>test</phase>
                        <goals><goal>attach-test-artifact</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Skipped by default: this module's tests need a JDK 17 toolchain
                         and the CN1 simulator classes, which the packaging build does not
                         set up. Opt in with -Dcn1.settings.skipTests=false. -->
                    <skipTests>${cn1.settings.skipTests}</skipTests>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
