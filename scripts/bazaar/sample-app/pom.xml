<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.codenameone.examples.bazaar</groupId>
        <artifactId>bazaar</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <groupId>com.codenameone.examples.bazaar</groupId>
    <artifactId>bazaar-restock-app</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>bazaar-restock-app</name>

    <!--
      Restock Alerts: a third-party app for Bazaar, written as its own Codename
      One Backend. It depends on nothing of Bazaar's, not even the shared DTOs;
      and reaches it only over HTTP, the way an app written by anyone else would.

        mvn -pl sample-app -Dcodename1.platform=backend cn1:backend
            runs it on this JVM (set restock.client-id and restock.client-secret
            in application.properties first)
        mvn -pl sample-app -Dcodename1.platform=backend test
            runs its own tests

      The end-to-end test that installs it into a running Bazaar lives in the
      backend module (RestockAppE2ETest), which compiles these sources into its
      test build: one Backend runs per process, and Bazaar's beans exist only in
      Bazaar's own test build.
    -->
    <dependencies>
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-backend</artifactId>
            <version>${cn1.version}</version>
        </dependency>
        <!--
             @BackendTest, MockMvc and TestRestTemplate: Spring Boot's test layer,
             under Codename One's package names. The tests are JUnit 5. Add
             org.mockito:mockito-core here too to replace a bean with @MockitoBean;
             tests that use it run on the JVM only.
        -->
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-backend-test</artifactId>
            <version>${cn1.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The app keeps no database, but @BackendTest opens an in-memory
             SQLite one for every test server, so the tests need the driver. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.9.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.codenameone</groupId>
                <artifactId>codenameone-maven-plugin</artifactId>
                <version>${cn1.plugin.version}</version>
                <!--
                     No <mainClass>: the entry point is generated from the
                     @RestController classes in this module. Set one only if this
                     server writes its own main instead.
                -->
                <executions>
                    <execution>
                        <id>cn1-process-annotations</id>
                        <phase>process-classes</phase>
                        <goals>
                            <!-- Generates a router and an entry point from the
                                 @RestController classes in this module. A no-op for
                                 a server that writes its own main instead. -->
                            <goal>process-annotations</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>cn1-process-test-annotations</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <!-- Generates the wiring each @BackendTest class runs
                                 against: the production beans, with the test's
                                 @TestConfiguration beans and mocks in place. -->
                            <goal>process-test-annotations</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.0.0-M5</version>
                <configuration>
                    <!-- One server runs per process: a JVM per test class keeps one
                         class's server and settings out of the next's. -->
                    <reuseForks>false</reuseForks>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
