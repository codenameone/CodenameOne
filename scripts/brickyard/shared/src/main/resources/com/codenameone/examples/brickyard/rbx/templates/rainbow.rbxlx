<Item class="ServerScriptService" referent="RBX106"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX107"><Properties><string name="Name">Goal</string><ProtectedString name="Source"><![CDATA[-- The goal, on every new player's screen for a few seconds.
local GOAL = "Climb six colour stages to the rainbow. Checkpoints save your stage."
game:GetService("Players").PlayerAdded:Connect(function(player)
    local gui = Instance.new("ScreenGui")
    gui.Name = "GoalHint"
    gui.ResetOnSpawn = false
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.8, 0, 0, 56)
    label.Position = UDim2.new(0.1, 0, 0, 60)
    label.BackgroundColor3 = Color3.fromRGB(22, 27, 46)
    label.BackgroundTransparency = 0.2
    label.TextColor3 = Color3.fromRGB(255, 196, 60)
    label.TextWrapped = true
    label.TextSize = 20
    label.Text = GOAL
    label.Parent = gui
    gui.Parent = player:WaitForChild("PlayerGui")
    task.delay(8, function() gui:Destroy() end)
end)
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX105"><Properties><string name="Name">Obby</string><ProtectedString name="Source"><![CDATA[local function stats(player, fields)
    local ls = Instance.new("Folder")
    ls.Name = "leaderstats"
    for _, f in ipairs(fields) do
        local v = Instance.new("IntValue")
        v.Name = f
        v.Parent = ls
    end
    ls.Parent = player
    return ls
end
local function playerOf(hit)
    local model = hit.Parent
    if model == nil then return nil end
    return game:GetService("Players"):GetPlayerFromCharacter(model)
end

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
-- An obby is retried constantly: back on the last checkpoint quickly.
Players.RespawnTime = 1.5
-- A new character starts on the player's last checkpoint, not back in
-- the lobby.
local function joined(p)
    stats(p, {"Stage", "Wins"})
    p.CharacterAdded:Connect(function(ch)
        local cp = workspace:FindFirstChild(p:GetAttribute("Checkpoint") or "")
        if cp then
            task.wait()
            ch:PivotTo(cp.CFrame + Vector3.new(0, 3.5, 0))
        end
    end)
end
Players.PlayerAdded:Connect(joined)
for _, p in ipairs(Players:GetPlayers()) do joined(p) end
for _, brick in ipairs(CollectionService:GetTagged("KillBrick")) do
    brick.Touched:Connect(function(hit)
        local h = hit.Parent and hit.Parent:FindFirstChildOfClass("Humanoid")
        if h then h.Health = 0 end
    end)
end
for _, cp in ipairs(CollectionService:GetTagged("Checkpoint")) do
    cp.Touched:Connect(function(hit)
        local p = playerOf(hit)
        if p and p.leaderstats.Stage.Value < cp:GetAttribute("Stage") then
            p.leaderstats.Stage.Value = cp:GetAttribute("Stage")
            p:SetAttribute("Checkpoint", cp.Name)
        end
    end)
end
for _, f in ipairs(CollectionService:GetTagged("Finish")) do
    f.Touched:Connect(function(hit)
        local p = playerOf(hit)
        if p and not p:GetAttribute("Finished") then
            p:SetAttribute("Finished", true)
            p.leaderstats.Wins.Value += 1
        end
    end)
end
local spinners = CollectionService:GetTagged("Spin")
RunService.Heartbeat:Connect(function(dt)
    for _, s in ipairs(spinners) do
        s.CFrame = s.CFrame * CFrame.Angles(0, dt * 1.6, 0)
    end
end)
for _, m in ipairs(CollectionService:GetTagged("Glide")) do
    local info = TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
    TweenService:Create(m, info, {CFrame = m.CFrame + Vector3.new(16, 0, 0)}):Play()
end
print("TEMPLATE READY rainbow")
]]></ProtectedString></Properties></Item></Item>
