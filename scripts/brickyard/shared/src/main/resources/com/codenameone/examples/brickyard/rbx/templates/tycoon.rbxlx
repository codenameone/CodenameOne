<Item class="ServerScriptService" referent="RBX213"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX214"><Properties><string name="Name">Goal</string><ProtectedString name="Source"><![CDATA[-- The goal, on every new player's screen for a few seconds.
local GOAL = "Collect the cash your factory makes, then buy droppers and upgrades."
game:GetService("Players").PlayerAdded:Connect(function(player)
    local gui = Instance.new("ScreenGui")
    gui.Name = "GoalHint"
    gui.ResetOnSpawn = false
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.8, 0, 0, 56)
    label.Position = UDim2.new(0.1, 0, 0, 60)
    label.BackgroundColor3 = Color3.fromRGB(22, 27, 46)
    label.BackgroundTransparency = 0.2
    label.TextColor3 = Color3.fromRGB(255, 196, 60)
    label.TextWrapped = true
    label.TextSize = 20
    label.Text = GOAL
    label.Parent = gui
    gui.Parent = player:WaitForChild("PlayerGui")
    task.delay(8, function() gui:Destroy() end)
end)
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX212"><Properties><string name="Name">Tycoon</string><ProtectedString name="Source"><![CDATA[local function stats(player, fields)
    local ls = Instance.new("Folder")
    ls.Name = "leaderstats"
    for _, f in ipairs(fields) do
        local v = Instance.new("IntValue")
        v.Name = f
        v.Parent = ls
    end
    ls.Parent = player
    return ls
end
local function playerOf(hit)
    local model = hit.Parent
    if model == nil then return nil end
    return game:GetService("Players"):GetPlayerFromCharacter(model)
end

local Players = game:GetService("Players")
local owner = nil
local droppers = 1
local value = 5
local function claim(p)
    if owner == nil then owner = p end
    stats(p, {"Cash"})
end
Players.PlayerAdded:Connect(claim)
for _, p in ipairs(Players:GetPlayers()) do claim(p) end
local ws = workspace
local drops = Instance.new("Folder")
drops.Name = "Drops"
drops.Parent = ws
ws.Collector.Touched:Connect(function(hit)
    if hit.Parent == drops and owner then
        owner.leaderstats.Cash.Value += hit:GetAttribute("Value") or value
        hit:Destroy()
    end
end)
local function pad(part, onBuy)
    local busy = false
    part.Touched:Connect(function(hit)
        local p = playerOf(hit)
        if p == nil or p ~= owner or busy then return end
        local price = part:GetAttribute("Price")
        if p.leaderstats.Cash.Value >= price then
            busy = true
            p.leaderstats.Cash.Value -= price
            onBuy()
            part:SetAttribute("Price", price * 2)
            task.wait(1)
            busy = false
        end
    end)
end
pad(ws.BuyDropper, function() droppers += 1 end)
pad(ws.BuyUpgrade, function() value *= 2 end)
task.spawn(function()
    while true do
        for i = 1, droppers do
            local d = Instance.new("Part")
            d.Size = Vector3.new(1, 1, 1)
            d.Color = Color3.fromRGB(255, 200, 40)
            d.Material = Enum.Material.Neon
            d.CFrame = ws.Dropper.CFrame * CFrame.new((i - 1) * 0.3, -3, 0)
            d:SetAttribute("Value", value)
            d.Parent = drops
            game:GetService("Debris"):AddItem(d, 30)
        end
        task.wait(1.5)
    end
end)
print("TEMPLATE READY tycoon")
]]></ProtectedString></Properties></Item></Item>
</roblox>
