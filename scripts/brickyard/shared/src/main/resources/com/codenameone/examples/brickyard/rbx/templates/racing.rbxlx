<Item class="ServerScriptService" referent="RBX230"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX231"><Properties><string name="Name">Goal</string><ProtectedString name="Source"><![CDATA[-- The goal, on every new player's screen for a few seconds.
local GOAL = "Three laps around the bay. Beat your best time."
game:GetService("Players").PlayerAdded:Connect(function(player)
    local gui = Instance.new("ScreenGui")
    gui.Name = "GoalHint"
    gui.ResetOnSpawn = false
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.8, 0, 0, 56)
    label.Position = UDim2.new(0.1, 0, 0, 60)
    label.BackgroundColor3 = Color3.fromRGB(22, 27, 46)
    label.BackgroundTransparency = 0.2
    label.TextColor3 = Color3.fromRGB(255, 196, 60)
    label.TextWrapped = true
    label.TextSize = 20
    label.Text = GOAL
    label.Parent = gui
    gui.Parent = player:WaitForChild("PlayerGui")
    task.delay(8, function() gui:Destroy() end)
end)
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX229"><Properties><string name="Name">Racing</string><ProtectedString name="Source"><![CDATA[local function stats(player, fields)
    local ls = Instance.new("Folder")
    ls.Name = "leaderstats"
    for _, f in ipairs(fields) do
        local v = Instance.new("IntValue")
        v.Name = f
        v.Parent = ls
    end
    ls.Parent = player
    return ls
end
local function playerOf(hit)
    local model = hit.Parent
    if model == nil then return nil end
    return game:GetService("Players"):GetPlayerFromCharacter(model)
end

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local GATES = 4
local state = {}
local function setup(p)
    stats(p, {"Laps", "Best"})
    state[p] = {next = 2, start = time()}
end
Players.PlayerAdded:Connect(setup)
for _, p in ipairs(Players:GetPlayers()) do setup(p) end
for _, g in ipairs(CollectionService:GetTagged("Gate")) do
    g.Touched:Connect(function(hit)
        local p = playerOf(hit)
        local s = p and state[p]
        if s == nil then return end
        local idx = g:GetAttribute("Index")
        if idx ~= s.next then return end
        if idx == 1 then
            local t = math.floor((time() - s.start) * 10)
            p.leaderstats.Laps.Value += 1
            if p.leaderstats.Best.Value == 0 or t < p.leaderstats.Best.Value then
                p.leaderstats.Best.Value = t
            end
            s.start = time()
        end
        s.next = idx % GATES + 1
    end)
end
print("TEMPLATE READY racing")
]]></ProtectedString></Properties></Item></Item>
