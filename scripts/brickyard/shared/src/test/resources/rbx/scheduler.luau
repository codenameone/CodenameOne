local order = {}
task.spawn(function() table.insert(order, "spawn") end)
task.defer(function() table.insert(order, "defer") end)
table.insert(order, "main")
local t0 = os.clock()
task.wait(0.5)
assert(order[1] == "spawn" and order[2] == "main" and order[3] == "defer", table.concat(order, ","))
local fired = false
task.delay(0.2, function() fired = true end)
task.wait(0.3)
assert(fired, "delay")
local th = task.delay(0.1, function() error("cancelled thread ran") end)
task.cancel(th)
task.wait(0.2)
local ev = Instance.new("BindableEvent")
task.delay(0.1, function() ev:Fire("hello") end)
local v = ev.Event:Wait()
assert(v == "hello", "Wait")
local beats = 0
local conn = game:GetService("RunService").Heartbeat:Connect(function(dt) beats += 1 end)
task.wait(0.25)
conn:Disconnect()
assert(beats >= 10, "heartbeat " .. beats)
local part = Instance.new("Part")
part.Parent = workspace
local tween = game:GetService("TweenService"):Create(part, TweenInfo.new(0.5, Enum.EasingStyle.Linear), {Transparency = 1})
tween:Play()
task.wait(0.25)
assert(part.Transparency > 0.3 and part.Transparency < 0.7, "mid tween " .. part.Transparency)
tween.Completed:Wait()
assert(part.Transparency == 1, "tween end")
game:GetService("Debris"):AddItem(part, 0.1)
task.wait(0.2)
assert(part.Parent == nil, "debris")
local child = Instance.new("Folder")
task.delay(0.1, function() child.Name = "Late"; child.Parent = workspace end)
assert(workspace:WaitForChild("Late", 2) == child, "WaitForChild")
print("DONE")
