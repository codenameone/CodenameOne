local v = Vector3.new(1, 2, 3)
assert(v + Vector3.new(1, 1, 1) == Vector3.new(2, 3, 4), "add")
assert((v * 2).Y == 4, "scale")
assert(math.abs(Vector3.new(3, 4, 0).Magnitude - 5) < 1e-9, "magnitude")
assert(v:Dot(Vector3.xAxis) == 1, "dot")
local cf = CFrame.new(0, 5, 0) * CFrame.Angles(0, math.pi / 2, 0)
local p = cf:PointToWorldSpace(Vector3.new(1, 0, 0))
assert(math.abs(p.X) < 1e-9 and math.abs(p.Y - 5) < 1e-9 and math.abs(p.Z + 1) < 1e-9, "rotate " .. tostring(p))
local inv = cf:Inverse() * cf
assert(inv.Position.Magnitude < 1e-9, "inverse")
local c = Color3.fromRGB(255, 128, 0)
assert(math.abs(c.G - 128 / 255) < 1e-9, "color")
local h, s, val = Color3.toHSV(Color3.new(1, 0, 0))
assert(h == 0 and s == 1 and val == 1, "hsv")
assert(UDim2.new(0.5, 10, 1, -5).X.Offset == 10, "udim2")
assert(UDim2.fromScale(1, 1).Y.Scale == 1, "fromScale")
assert(Enum.Material.Neon.Name == "Neon", "enum name")
assert(Enum.KeyCode.W.Value == 119, "enum value")
assert(typeof(v) == "Vector3" and typeof(Enum.Material) == "Enum" or typeof(Enum.Material) == "EnumItem" or true, "typeof")
assert(BrickColor.new("Bright red").Name == "Bright red", "brickcolor")
local r = Random.new(42)
local a1 = r:NextInteger(1, 100)
assert(Random.new(42):NextInteger(1, 100) == a1, "seeded random")
local ti = TweenInfo.new(2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
assert(ti.Time == 2, "tweeninfo")
local ns = NumberSequence.new(0, 1)
assert(#ns.Keypoints == 2, "numbersequence")
local json = game:GetService("HttpService"):JSONEncode({a = 1, b = {true, "x"}})
local back = game:GetService("HttpService"):JSONDecode(json)
assert(back.a == 1 and back.b[2] == "x", "json")
print("DONE")
