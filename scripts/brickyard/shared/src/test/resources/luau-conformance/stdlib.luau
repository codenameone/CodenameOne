assert(string.format("%d %5.2f %s %x %q", 42, 3.14159, "hi", 255, "a\n") == '42  3.14 hi ff "a\\n"', string.format("%d %5.2f %s %x %q", 42, 3.14159, "hi", 255, "a\n"))
assert(string.format("%g %g %g", 0.0001, 1e20, 100) == "0.0001 1e+20 100", string.format("%g %g %g", 0.0001, 1e20, 100))
assert(string.format("%.3f", 2.0005) == "2.001" or string.format("%.3f", 2.0005) == "2.000")
assert(string.format("%05d|%-4s|", 42, "ab") == "00042|ab  |")
assert(("hello world"):find("wor") == 7)
assert(("hello world"):match("(%w+) (%w+)") == "hello")
local a, b = ("key=val"):match("(%w+)=(%w+)")
assert(a == "key" and b == "val")
assert(("abc"):gsub("b", "X") == "aXc")
assert(select(2, ("aaa"):gsub("a", "b")) == 3)
assert(("hello"):gsub("l+", function(m) return #m end) == "he2o")
assert(("$name is $age"):gsub("%$(%w+)", {name = "Bob", age = 3}) == "Bob is 3")
local words = {}
for w in ("one two  three"):gmatch("%a+") do table.insert(words, w) end
assert(#words == 3 and words[3] == "three")
assert(("THE (quick) fox"):find("%((%a+)%)") == 5)
assert(("[[x]]"):match("%b[]") == "[[x]]")
assert(("  trim  "):match("^%s*(.-)%s*$") == "trim")
assert(("THE"):lower() == "the" and ("the"):upper() == "THE")
assert(("abc"):rep(3, ",") == "abc,abc,abc")
assert(("hello"):sub(2, -2) == "ell" and ("hello"):sub(-3) == "llo")
assert(("A"):byte() == 65 and string.char(72, 105) == "Hi")
local parts = ("a,b,,c"):split(",")
assert(#parts == 4 and parts[3] == "")
-- table
local t = {5, 2, 8, 1}
table.sort(t)
assert(table.concat(t, ",") == "1,2,5,8")
table.sort(t, function(x, y) return x > y end)
assert(t[1] == 8)
table.insert(t, 1, 99)
assert(t[1] == 99 and #t == 5)
assert(table.remove(t) == 1 and #t == 4)
assert(table.find(t, 5) == 3)
local fz = table.freeze({1})
assert(not pcall(function() fz[1] = 2 end))
local cl = table.clone({1, 2, x = 3})
assert(cl.x == 3 and #cl == 2)
assert(select("#", table.unpack({1, 2, 3})) == 3)
local pk = table.pack(1, nil, 3)
assert(pk.n == 3)
-- math
assert(math.floor(3.7) == 3 and math.ceil(3.2) == 4 and math.abs(-2) == 2)
assert(math.max(1, 5, 3) == 5 and math.min(4, 2) == 2)
assert(math.clamp(15, 0, 10) == 10 and math.sign(-3) == -1 and math.round(2.5) == 3)
assert(math.abs(math.sin(math.pi / 2) - 1) < 1e-12)
assert(math.noise(1, 2, 3) == 0)
math.randomseed(42)
for i = 1, 100 do local r = math.random(1, 6); assert(r >= 1 and r <= 6 and r == math.floor(r)) end
assert(math.random() < 1)
assert(math.abs(math.log(math.exp(2)) - 2) < 1e-9)
assert(tonumber("0x10") == 16 and tonumber("ff", 16) == 255 and tonumber("z") == nil and tonumber("  5  ") == 5)
-- bit32
assert(bit32.band(0xF0, 0x3C) == 0x30 and bit32.bor(1, 2) == 3 and bit32.bxor(3, 1) == 2)
assert(bit32.lshift(1, 4) == 16 and bit32.rshift(256, 4) == 16 and bit32.bnot(0) == 0xFFFFFFFF)
assert(bit32.extract(0xABCD, 4, 4) == 0xC)
-- utf8
assert(utf8.char(72, 228, 8364) == "H\xC3\xA4\xE2\x82\xAC")
assert(utf8.len("H\xC3\xA4\xE2\x82\xAC") == 3)
local cps = {}
for _, c in utf8.codes("a\xC3\xA4") do table.insert(cps, c) end
assert(cps[2] == 228)
-- buffer
local buf = buffer.create(8)
buffer.writeu32(buf, 0, 0xDEADBEEF)
assert(buffer.readu32(buf, 0) == 0xDEADBEEF)
buffer.writei16(buf, 4, -2)
assert(buffer.readi16(buf, 4) == -2)
buffer.writef32(buf, 4, 1.5)
assert(buffer.readf32(buf, 4) == 1.5)
assert(buffer.tostring(buffer.fromstring("abc")) == "abc")
-- os
assert(os.time({year = 2000, month = 1, day = 1, hour = 0}) == 946684800)
assert(os.date("!%Y-%m-%d", 946684800) == "2000-01-01")
assert(type(os.clock()) == "number")
print("stdlib OK")
