<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" version="4">
	<Meta name="ExplicitAutoJoints">true</Meta>
	<External>null</External>
	<External>nil</External>
	<Item class="Workspace" referent="RBX1">
		<Properties>
			<string name="Name">Workspace</string>
			<float name="Gravity">150</float>
			<Ref name="CurrentCamera">RBX9</Ref>
		</Properties>
		<Item class="Camera" referent="RBX9">
			<Properties>
				<string name="Name">Camera</string>
				<float name="FieldOfView">60</float>
			</Properties>
		</Item>
		<Item class="Model" referent="RBX2">
			<Properties>
				<string name="Name">Tower</string>
				<Ref name="PrimaryPart">RBX3</Ref>
				<OptionalCoordinateFrame name="WorldPivotData"><CFrame><X>0</X><Y>5</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CFrame></OptionalCoordinateFrame>
			</Properties>
			<Item class="Part" referent="RBX3">
				<Properties>
					<string name="Name">Base &amp; Top</string>
					<bool name="Anchored">true</bool>
					<CoordinateFrame name="CFrame"><X>1.5</X><Y>2</Y><Z>-3</Z><R00>0</R00><R01>0</R01><R02>1</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>-1</R20><R21>0</R21><R22>0</R22></CoordinateFrame>
					<Vector3 name="size"><X>4</X><Y>1.25</Y><Z>2</Z></Vector3>
					<Color3uint8 name="Color3uint8">4294901760</Color3uint8>
					<token name="Material">288</token>
					<token name="shape">0</token>
					<float name="Transparency">0.25</float>
					<BinaryString name="Tags">S2lsbEJyaWNrAENoZWNrcG9pbnQ=</BinaryString>
					<token name="FrontSurface">0</token>
					<int name="SomethingNew">7</int>
				</Properties>
			</Item>
			<Item class="Sparkler" referent="RBX4">
				<Properties><string name="Name">Mystery</string></Properties>
			</Item>
			<Item class="Decal" referent="RBX5">
				<Properties>
					<string name="Name">Logo</string>
					<Content name="Texture"><url>rbxassetid://123456</url></Content>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="Lighting" referent="RBX6">
		<Properties>
			<string name="Name">Lighting</string>
			<string name="TimeOfDay">06:30:00</string>
			<Color3 name="Ambient"><R>0.5</R><G>0.25</G><B>1</B></Color3>
		</Properties>
	</Item>
	<Item class="ServerScriptService" referent="RBX7">
		<Properties><string name="Name">ServerScriptService</string></Properties>
		<Item class="Script" referent="RBX8">
			<Properties>
				<string name="Name">Main</string>
				<ProtectedString name="Source"><![CDATA[local t = workspace.Tower
local p = t.PrimaryPart
assert(p.Name == "Base & Top", p.Name)
assert(p.Anchored)
assert(p.Size == Vector3.new(4, 1.25, 2))
assert(p.Color == Color3.fromRGB(255, 0, 0))
assert(p.Material == Enum.Material.Neon)
assert(math.abs(p.Transparency - 0.25) < 1e-6)
assert(p.CFrame.Position == Vector3.new(1.5, 2, -3))
assert(game:GetService("CollectionService"):HasTag(p, "KillBrick"))
assert(workspace.Gravity == 150)
assert(workspace.CurrentCamera.FieldOfView == 60)
assert(math.abs(game.Lighting.ClockTime - 6.5) < 1e-9)
assert(t.Mystery:IsA("Folder"))
if workspace.Gravity < 0 then game:GetService("NoSuchService") end
print("DONE")
]]></ProtectedString>
			</Properties>
		</Item>
	</Item>
</roblox>
